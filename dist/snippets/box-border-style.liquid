{%- comment -%}
  box-border-style — the custom properties a border asks for, semicolon-joined. The value half of
  `box-border-edges`; a caller needs both, appends this to the same element's own style list, and
  renders it only where the edge half drew something — the edges are what say a border exists.

  The WIDTH is not here: it is per-edge, and each `bt-/bb-/bl-/br-` class carries its own.

  Inputs:
    role           — border_role; only 'palette' / 'gradient' / 'custom' resolve to a value here,
                     because a slot role reaches the element as a class instead.
    palette_token  — border_role_palette token name
    gradient_token — border_role_gradient token name
    custom_color   — border_role_custom raw value
    style          — border_style
{%- endcomment -%}
{%- assign decls = blank -%}
{%- assign decls = decls | push: '--border-style: {{ style }}' -%}
{%- capture border_value -%}
  {%- render 'role-color-value', kind: 'border', role: role, palette: palette_token,
      custom: custom_color, gradient: gradient_token -%}
{%- endcapture -%}
{%- if border_value != blank -%}
  {%- assign decls = decls | push: '--border: {{ border_value }}' -%}
{%- endif -%}
{{- decls | join: ';' -}}
