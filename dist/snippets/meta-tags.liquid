<meta charset='utf-8'>
<meta
  http-equiv='X-UA-Compatible'
  content='IE=edge'
>
<meta
  name='viewport'
  content='width=device-width,initial-scale=1,viewport-fit=cover'
>
<meta
  name='view-transition'
  content='same-origin'
>

{% if shop.verification.google %}
  <meta
    name='google-site-verification'
    content='{{ shop.verification.google | escape }}'
  >
{% endif %}
{% if shop.verification.bing %}
  <meta
    name='msvalidate.01'
    content='{{ shop.verification.bing | escape }}'
  >
{% endif %}
{% if shop.verification.pinterest %}
  <meta
    name='p:domain_verify'
    content='{{ shop.verification.pinterest | escape }}'
  >
{% endif %}
{% if shop.verification.facebook %}
  <meta
    name='facebook-domain-verification'
    content='{{ shop.verification.facebook | escape }}'
  >
{% endif %}

{% liquid
  if page.title != blank
    assign meta_title = page.title
  else
    assign meta_title = page.name | append: ' – ' | append: shop.name
  endif
  assign og_url = page.canonical_url | default: shop.origin
  assign og_type = 'website'
  assign og_description = page.description | default: meta_title
%}

<meta
  property='og:site_name'
  content='{{ shop.name }}'
>
<meta
  property='og:url'
  content='{{ og_url }}'
>
<meta
  property='og:title'
  content='{{ meta_title | escape }}'
>
<meta
  property='og:type'
  content='{{ og_type }}'
>
<meta
  property='og:description'
  content='{{ og_description | escape }}'
>

{% if page.image != blank %}
  <meta
    property='og:image'
    content='{{ page.image | image_url: width: 1200 }}'
  >
  <meta
    property='og:image:width'
    content='1200'
  >
  <meta
    property='og:image:height'
    content='630'
  >
{% endif %}

{% if settings.social_twitter_link != blank %}
  <meta
    name='twitter:site'
    content='{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}'
  >
{% endif %}
<meta
  name='twitter:card'
  content='summary_large_image'
>
<meta
  name='twitter:title'
  content='{{ meta_title | escape }}'
>
<meta
  name='twitter:description'
  content='{{ og_description | escape }}'
>

<title>{{ meta_title | escape }}</title>

<link
  rel='canonical'
  href='{{ og_url }}'
>

{% if page.robots %}
  <meta
    name='robots'
    content='{{ page.robots }}'
  >
{% endif %}

{% if page.description %}
  <meta
    name='description'
    content='{{ page.description | escape }}'
  >
{% endif %}

{% if page.keywords %}
  <meta name='keywords' content='{{ page.keywords | escape }}'>
{% endif %}

{% if page.structured_data %}
  <script type='application/ld+json'>
    {{ page.structured_data | structured_data }}
  </script>
{% endif %}
