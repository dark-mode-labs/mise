{% assign s = block.settings %}

{%- capture overlay_color_value -%}
  {%- render 'role-color-value', kind: 'bg', role: s.overlay_role,
      palette: s.overlay_role_palette, custom: s.overlay_role_custom, gradient: s.overlay_role_gradient -%}
{%- endcapture -%}
{%- capture overlay_color_inactive_value -%}
  {%- render 'role-color-value', kind: 'bg', role: s.overlay_role_inactive,
      palette: s.overlay_role_inactive_palette, custom: s.overlay_role_inactive_custom, gradient: s.overlay_role_inactive_gradient -%}
{%- endcapture -%}
{%- capture text_color_value -%}
  {%- render 'role-color-value', kind: 'text', role: s.text_role,
      palette: s.text_role_palette, custom: s.text_role_custom, gradient: s.text_role_gradient -%}
{%- endcapture -%}
{%- capture text_color_inactive_value -%}
  {%- render 'role-color-value', kind: 'text', role: s.text_role_inactive,
      palette: s.text_role_inactive_palette, custom: s.text_role_inactive_custom, gradient: s.text_role_inactive_gradient -%}
{%- endcapture -%}
{% assign classes = '' %}
{% assign styles = '' %}
{% assign active_state_classes = '' %}
{% assign active_state_styles = '' %}
{% assign inactive_state_classes = '' %}
{% assign inactive_state_styles = '' %}

{% assign classes = classes | push_if: "surface-{{ s.surface_id | default: 'default' }}", s.surface_override %}
{% if s.height != blank and s.height != 'auto' %}
  {% assign classes = classes | push: 'height-{{ s.height }}' %}
{% endif %}
{% if s.width != blank %}
  {% assign classes = classes | push: 'width-{{ s.width }}' %}
{% endif %}
{% if s.padding_top != blank or s.padding_bottom != blank %}
  {% assign classes = classes | push: 'pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}' %}
{% endif %}
{% if s.padding_left != blank or s.padding_right != blank %}
  {% assign classes = classes | push: 'pl-{{ s.padding_left }} pr-{{ s.padding_right }}' %}
{% endif %}
{% if s.margin_top != blank or s.margin_bottom != blank %}
  {% assign classes = classes | push: 'mt-{{ s.margin_top }} mb-{{ s.margin_bottom }}' %}
{% endif %}
{% if s.margin_left != blank or s.margin_right != blank %}
  {% assign classes = classes | push: 'ml-{{ s.margin_left }} mr-{{ s.margin_right }}' %}
{% endif %}
{% if s.border_radius_override %}
  {% assign classes = classes | push: 'rounded-custom' %}
  {% assign styles = styles | push: '--radius-custom: {{ s.border_radius }}px' %}
{% else %}
  {% assign classes = classes | push: 'rounded-global' %}
{% endif %}
{% if s.vertical_align != blank or s.content_align != blank %}
  {% assign classes = classes | push: 'flex' | push: 'direction-row' %}
  {% if s.vertical_align != blank %}
    {% assign classes = classes | push: 'vertical-{{ s.vertical_align }}' %}
  {% endif %}
  {% if s.content_align != blank %}
    {% assign classes = classes | push: 'content-{{ s.content_align }}' %}
  {% endif %}
{% endif %}
{%- capture border_inactive_class_str -%}{%- render 'box-border-edges', role: s.border_role_inactive,
  top: s.border_top_inactive, right: s.border_right_inactive,
  bottom: s.border_bottom_inactive, left: s.border_left_inactive -%}{%- endcapture -%}
{% if border_inactive_class_str != blank %}
  {% assign inactive_state_classes = inactive_state_classes | push: border_inactive_class_str %}
  {%- capture border_inactive_style_str -%}{%- render 'box-border-style',
    role: s.border_role_inactive, palette_token: s.border_role_inactive_palette,
    gradient_token: s.border_role_inactive_gradient, custom_color: s.border_role_inactive_custom,
    style: s.border_style_inactive -%}{%- endcapture -%}
  {% assign inactive_state_styles = inactive_state_styles | push: border_inactive_style_str %}
{% endif %}

{% if s.enable_overlay_inactive %}
  {% if overlay_color_inactive_value != blank -%}
    {%- assign inactive_state_styles = inactive_state_styles | push: '--block-bg:{{ overlay_color_inactive_value }}' -%}
    {%- assign inactive_state_classes = inactive_state_classes | push: 'block-bg' | push: 'tab-head-bg' -%}
  {%- elsif s.overlay_role_inactive and s.overlay_role_inactive != 'none' -%}
    {%- assign inactive_state_classes = inactive_state_classes | push: 'bg-{{ s.overlay_role_inactive }}' -%}
  {%- endif %}
{% endif %}

{% for ef_id in s.effect_inactive %}
  {% assign inactive_state_classes = inactive_state_classes | push: 'ef-{{ ef_id }}' %}
{% endfor %}

{% if text_color_inactive_value != blank %}
  {% assign inactive_state_classes = inactive_state_classes | push: 'text-primary' %}
  {% assign inactive_state_styles = inactive_state_styles | push: '--text:{{ text_color_inactive_value }}' %}
{% else %}
  {%- capture inactive_text_class -%}{%- render 'text-color-class', color_role: s.text_role_inactive -%}{%- endcapture -%}
  {% if inactive_text_class != blank %}
    {% assign inactive_state_classes = inactive_state_classes | push: inactive_text_class %}
  {% endif %}
{% endif %}

{%- capture border_class_str -%}{%- render 'box-border-edges', role: s.border_role,
  top: s.border_top, right: s.border_right, bottom: s.border_bottom, left: s.border_left -%}{%- endcapture -%}
{% if border_class_str != blank %}
  {% assign active_state_classes = active_state_classes | push: border_class_str %}
  {%- capture border_style_str -%}{%- render 'box-border-style',
    role: s.border_role, palette_token: s.border_role_palette,
    gradient_token: s.border_role_gradient, custom_color: s.border_role_custom,
    style: s.border_style -%}{%- endcapture -%}
  {% assign active_state_styles = active_state_styles | push: border_style_str %}
{% endif %}

{% if s.enable_overlay %}
  {% if overlay_color_value != blank -%}
    {%- assign active_state_styles = active_state_styles | push: '--block-bg:{{ overlay_color_value }}' -%}
    {%- assign active_state_classes = active_state_classes | push: 'block-bg' | push: 'tab-head-bg' -%}
  {%- elsif s.overlay_role and s.overlay_role != 'none' -%}
    {%- assign active_state_classes = active_state_classes | push: 'bg-{{ s.overlay_role }}' -%}
  {%- endif %}
{% endif %}

{% for ef_id in s.effect %}
  {% assign active_state_classes = active_state_classes | push: 'ef-{{ ef_id }}' %}
{% endfor %}

{% if text_color_value != blank %}
  {% assign active_state_classes = active_state_classes | push: 'text-primary' %}
  {% assign active_state_styles = active_state_styles | push: '--text:{{ text_color_value }}' %}
{% else %}
  {%- capture active_text_class -%}{%- render 'text-color-class', color_role: s.text_role -%}{%- endcapture -%}
  {% if active_text_class != blank %}
    {% assign active_state_classes = active_state_classes | push: active_text_class %}
  {% endif %}
{% endif %}

{% assign tab_group = s.tab_group %}
{% if tab_group == blank %}{% assign tab_group = section.id %}{% endif %}

<div
  {{ context.attached_attributes }}
  class='tab-head cursor-pointer relative {{ classes | join: ' ' }}'
  style='{{ styles | join: ';' }}'
  data-behavior='tab-head'
  data-tab-active-class='{{ active_state_classes | join: ' ' }}'
  data-tab-active-styles='{{ active_state_styles | join: ';' }}'
  data-tab-inactive-class='{{ inactive_state_classes | join: ' ' }}'
  data-tab-inactive-styles='{{ inactive_state_styles | join: ';' }}'
  data-tab-group='{{ tab_group }}'
  data-action='tab-switch'
  data-tab-id='{{ s.tab_id }}'
  {%- if s.default_tab_id != blank %}
    aria-selected='{% if s.tab_id == s.default_tab_id %}true{% else %}false{% endif %}'
  {%- endif %}
  role='tab'
>
  {% assign inner_classes = 'relative z-10' %}
  <div class='{{ inner_classes | join: ' ' }}'>
    {% content_for 'blocks' %}
  </div>
</div>
{% schema %}
