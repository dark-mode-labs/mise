{% assign s = block.settings %}
{% assign styles = 'display: none; --dot-active-scale: 1' %}

{% assign dc = blank %}
{% if s.dot_role == 'palette' and s.dot_role_palette != blank -%}
  {%- assign dc = 'var(--palette-{{ s.dot_role_palette }})' %}
{% elsif s.dot_role == 'custom' and s.dot_role_custom != blank -%}
  {%- assign dc = s.dot_role_custom %}
{% elsif s.dot_role == 'gradient' and s.dot_role_gradient != blank -%}
  {%- assign dc = 'var(--gradient-{{ s.dot_role_gradient }})' %}
{% elsif s.dot_role != blank and s.dot_role != 'none' -%}
  {%- assign slot = s.dot_role
    | replace: 'body', 'background'
    | replace: 'accent', 'accent-bg'
    | replace: 'button', 'button-bg'
    | replace: 'control', 'control-bg'
  -%}
  {%- assign dc = 'var(--{{ slot }})' %}
{% endif %}
{% if dc != blank %}{% assign styles = '{{ styles }}; --dot-color: {{ dc }}' %}{% endif %}

{% assign dm = blank %}
{% if s.dot_muted_role == 'palette' and s.dot_muted_role_palette != blank -%}
  {%- assign dm = 'var(--palette-{{ s.dot_muted_role_palette }})' %}
{% elsif s.dot_muted_role == 'custom' and s.dot_muted_role_custom != blank -%}
  {%- assign dm = s.dot_muted_role_custom %}
{% elsif s.dot_muted_role == 'gradient' and s.dot_muted_role_gradient != blank -%}
  {%- assign dm = 'var(--gradient-{{ s.dot_muted_role_gradient }})' %}
{% elsif s.dot_muted_role != blank and s.dot_muted_role != 'none' -%}
  {%- assign slot = s.dot_muted_role
    | replace: 'body', 'background'
    | replace: 'accent', 'accent-bg'
    | replace: 'button', 'button-bg'
    | replace: 'control', 'control-bg'
  -%}
  {%- assign dm = 'var(--{{ slot }})' %}
{% endif %}
{% if dm != blank %}{% assign styles = '{{ styles }}; --dot-muted-color: {{ dm }}; --dot-muted-opacity: 1' %}{% endif %}

{% if s.dot_size != blank and s.dot_size != 'none' -%}
  {%- assign styles = '{{ styles }}; --dot-size: var(--space-{{ s.dot_size }})' -%}
{%- endif %}

{% assign classes = 'slideshow-dots flex items-center' %}
{% if s.dot_gap != blank and s.dot_gap != 'none' %}{% assign classes = '{{ classes }} gap-{{ s.dot_gap }}' %}{% endif %}

<div
  class='{{ classes }}'
  data-dot-style='{{ s.dot_style }}'
  style='{{ styles }}'
  {{ context.attached_attributes }}
></div>
{% schema %}
{
  "name": "Carousel Dots",
  "settings": [
    {
      "type": "select",
      "id": "dot_style",
      "label": "Pagination Style",
      "default": "dots",
      "options": [
        { "value": "dots", "label": "Dots" },
        { "value": "bars", "label": "Bars" },
        { "value": "numbers", "label": "Numbers" }
      ]
    },
    {
      "type": "space",
      "id": "dot_size",
      "label": "Dot Size"
    },
    {
      "type": "space",
      "id": "dot_gap",
      "label": "Dot Gap"
    },
    {
      "type": "select",
      "id": "dot_role",
      "label": "Active Dot Color",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "body", "label": "Body" },
        { "value": "body-alt", "label": "Body (alt)" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface (alt)" },
        { "value": "accent", "label": "Accent" },
        { "value": "button", "label": "Button" },
        { "value": "control", "label": "Control" },
        { "value": "palette", "label": "Base Palette" },
        { "value": "custom", "label": "Raw Color" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "palette",
      "id": "dot_role_palette",
      "label": "Active Palette Token",
      "default": "brand",
      "conditional": "setting.dot_role == 'palette'"
    },
    {
      "type": "color",
      "id": "dot_role_custom",
      "label": "Raw Active Color",
      "conditional": "setting.dot_role == 'custom'"
    },
    {
      "type": "gradient",
      "id": "dot_role_gradient",
      "label": "Active Gradient",
      "conditional": "setting.dot_role == 'gradient'"
    },
    {
      "type": "select",
      "id": "dot_muted_role",
      "label": "Muted Dot Color",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "body", "label": "Body" },
        { "value": "body-alt", "label": "Body (alt)" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface (alt)" },
        { "value": "accent", "label": "Accent" },
        { "value": "button", "label": "Button" },
        { "value": "control", "label": "Control" },
        { "value": "palette", "label": "Base Palette" },
        { "value": "custom", "label": "Raw Color" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "palette",
      "id": "dot_muted_role_palette",
      "label": "Muted Palette Token",
      "default": "brand",
      "conditional": "setting.dot_muted_role == 'palette'"
    },
    {
      "type": "color",
      "id": "dot_muted_role_custom",
      "label": "Raw Muted Color",
      "conditional": "setting.dot_muted_role == 'custom'"
    },
    {
      "type": "gradient",
      "id": "dot_muted_role_gradient",
      "label": "Muted Gradient",
      "conditional": "setting.dot_muted_role == 'gradient'"
    }
  ]
}
{% endschema %}
