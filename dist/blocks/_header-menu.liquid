{% assign s = block.settings %}

{% assign nav_classes = 'header-nav'
  | push: 'pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}'
  | push: 'pl-{{ s.padding_left }} pr-{{ s.padding_right }}'
%}
{% unless s.border_mode == 'none' or s.border_mode == blank %}
  {% assign nav_classes = nav_classes
    | push: 'group-border-{{ s.border_mode }}'
    | push: 'group-border-size-{{ s.border_size }}'
  %}
  {% if s.border_role != blank
    and s.border_role != 'none'
    and s.border_role != 'custom'
    and s.border_role != 'palette'
  %}
    {% assign nav_classes = nav_classes | push: 'border-{{ s.border_role }}' %}
  {% endif %}
  {% if s.border_mode == 'custom' %}
    {% assign nav_classes = nav_classes
      | push_if: 'group-border-custom-left', s.border_custom_left
      | push_if: 'group-border-custom-right', s.border_custom_right
      | push_if: 'group-border-custom-top', s.border_custom_top
      | push_if: 'group-border-custom-bottom', s.border_custom_bottom
    %}
  {% endif %}
{% endunless %}

{% if s.surface_override %}
  {% assign nav_classes = nav_classes | push: "surface-{{ s.surface_id | default: 'default' }}" %}
{% endif %}

{% assign block_classes = nav_classes | join: ' ' %}

{%- capture text_color_value -%}
  {%- if s.text_role != 'primary' -%}
    {%- render 'role-color-value', kind: 'text', role: s.text_role, slots: true,
        palette: s.text_role_palette, custom: s.text_role_custom -%}
  {%- endif -%}
{%- endcapture -%}
{% assign styles = blank %}
{% if text_color_value != blank %}
  {% assign styles = styles | push: '--text: {{ text_color_value }}' %}
{% endif %}
{%- capture border_color_value -%}
  {%- render 'role-color-value', kind: 'border', role: s.border_role,
      palette: s.border_role_palette, custom: s.border_role_custom -%}
{%- endcapture -%}
{% unless s.border_mode == 'none' or s.border_mode == blank %}
  {% assign styles = styles | push: '--border-style: {{ s.border_style }}' %}
  {% if s.border_size == 'custom' %}
    {% assign styles = styles | push: '--border-width: {{ s.border_size_custom }}px' %}
  {% endif %}
  {% if border_color_value != blank %}
    {% assign styles = styles | push: '--border: {{ border_color_value }}' %}
  {% endif %}
{% endunless %}
{% assign styles = styles | push_if: '--radius-custom: {{ s.border_radius }}px', s.border_radius_override %}
{% assign block_styles = styles | join: ';' %}

{% assign color_role = s.text_role %}
{% if s.text_role == 'custom' or s.text_role == 'palette' %}
  {% assign color_role = 'primary' %}
{% endif %}

{% assign utilities = blank %}

{% case s.text_wrap %}
  {% when 'nowrap' %}
    {% assign utilities = utilities | push: 'whitespace-nowrap' %}
  {% when 'balance' %}
    {% assign utilities = utilities | push: 'text-balance' %}
{% endcase %}

{% assign utility_classes = utilities | join: ' ' %}

{% assign link_classes = 'flex direction-row'
  | push: 'vertical-{{ s.link_align }}'
  | push_if: 'rounded-custom', s.border_radius_override
  | push: 'pt-{{ s.link_padding_top }} pb-{{ s.link_padding_bottom }}'
  | push: 'pl-{{ s.link_padding_left }} pr-{{ s.link_padding_right }}'
%}
{% for ef_id in s.link_effect %}
  {% assign link_classes = link_classes | push: 'ef-{{ ef_id }}' %}
{% endfor %}
{% if s.link_border_role != blank and s.link_border_role != 'none' %}
  {% assign link_classes = link_classes
    | push: 'group-border-custom-bottom group-border-size-{{ s.link_border_size }}'
  %}
  {% if s.link_border_role != 'custom' and s.link_border_role != 'palette' %}
    {% assign link_classes = link_classes | push: 'border-{{ s.link_border_role }}' %}
  {% endif %}
{% endif %}
{% assign link_class_str = link_classes | join: ' ' %}

{%- capture link_border_value -%}
  {%- render 'role-color-value', kind: 'border', role: s.link_border_role,
      palette: s.link_border_role_palette, custom: s.link_border_role_custom -%}
{%- endcapture -%}
{% assign link_styles = blank %}
{% if link_border_value != blank %}
  {% assign link_styles = link_styles | push: '--border-style:solid' | push: '--border: {{ link_border_value }}' %}
{% endif %}
{% assign link_style_str = link_styles | join: ';' %}

{% assign list_classes = 'flex direction-row' | push: 'vertical-{{ s.link_align }}' | push: 'gap-{{ s.gap }}' %}
{% assign list_class_str = list_classes | join: ' ' %}

{%- comment -%}Unlike `_tab-head`, the state is known at render, so one bag is chosen here.{%- endcomment -%}
{% assign active_classes = 'flex direction-row'
  | push: 'vertical-{{ s.link_align }}'
  | push_if: 'rounded-custom', s.border_radius_override
  | push: 'pt-{{ s.link_padding_top_active }} pb-{{ s.link_padding_bottom_active }}'
  | push: 'pl-{{ s.link_padding_left_active }} pr-{{ s.link_padding_right_active }}'
%}
{% for ef_id in s.link_effect %}
  {% assign active_classes = active_classes | push: 'ef-{{ ef_id }}' %}
{% endfor %}
{% if s.bg_role_active != blank
  and s.bg_role_active != 'none'
  and s.bg_role_active != 'custom'
  and s.bg_role_active != 'palette'
%}
  {% assign active_classes = active_classes | push: 'bg-{{ s.bg_role_active }}' %}
{% endif %}
{% if s.link_border_role_active != blank and s.link_border_role_active != 'none' %}
  {% assign active_classes = active_classes
    | push: 'group-border-custom-bottom group-border-size-{{ s.link_border_size_active }}'
  %}
  {% if s.link_border_role_active != 'custom' and s.link_border_role_active != 'palette' %}
    {% assign active_classes = active_classes | push: 'border-{{ s.link_border_role_active }}' %}
  {% endif %}
{% endif %}
{%- capture active_text_class -%}{%- render 'text-color-class', color_role: s.text_role_active -%}{%- endcapture -%}
{% if active_text_class != blank %}
  {% assign active_classes = active_classes | push: active_text_class %}
{% elsif s.text_role_active == 'custom' or s.text_role_active == 'palette' %}
  {% assign active_classes = active_classes | push: 'text-primary' %}
{% endif %}
{%- capture active_bg_value -%}
  {%- render 'role-color-value', kind: 'bg', role: s.bg_role_active,
      palette: s.bg_role_active_palette, custom: s.bg_role_active_custom -%}
{%- endcapture -%}
{% if active_bg_value != blank %}
  {% assign active_classes = active_classes | push: 'block-bg' %}
{% endif %}
{% assign active_class_str = active_classes | join: ' ' %}

{% assign active_styles = blank %}
{%- capture active_text_value -%}
  {%- render 'role-color-value', kind: 'text', role: s.text_role_active,
      palette: s.text_role_active_palette, custom: s.text_role_active_custom -%}
{%- endcapture -%}
{% if active_text_value != blank %}
  {% assign active_styles = active_styles | push: '--text: {{ active_text_value }}' %}
{% endif %}
{% if active_bg_value != blank %}
  {% assign active_styles = active_styles | push: '--block-bg: {{ active_bg_value }}' %}
{% endif %}
{%- capture active_border_value -%}
  {%- render 'role-color-value', kind: 'border', role: s.link_border_role_active,
      palette: s.link_border_role_active_palette, custom: s.link_border_role_active_custom -%}
{%- endcapture -%}
{% if active_border_value != blank %}
  {% assign active_styles = active_styles
    | push: '--border-style:solid'
    | push: '--border: {{ active_border_value }}'
  %}
{% endif %}
{% assign active_style_str = active_styles | join: ';' %}
{%- comment -%}No declared paint means no state: swapping an unfilled bag in strips the link.{%- endcomment -%}
{% assign has_active_state = false %}
{% if s.text_role_active != blank or s.bg_role_active != blank or s.link_border_role_active != blank %}
  {% assign has_active_state = true %}
{% endif %}

<nav
  class='{{ block_classes }}'
  style='{{ block_styles }}'
  {{ context.attached_attributes }}
>
  <ul class='{{ list_class_str }}'>
    {% for link in s.nav.links %}
      {% assign this_link_class = link_class_str %}
      {% assign this_link_style = link_style_str %}
      {%- comment -%}A link with no id can never be the current page, so a blank one never matches.{%- endcomment -%}
      {% if has_active_state and link.link_id != blank and link.link_id == page.uuid %}
        {% assign this_link_class = active_class_str %}
        {% assign this_link_style = active_style_str %}
      {% endif %}
      <li class='group flex direction-row vertical-{{ s.link_align }} relative'>
        <a
          href='{{ link.url }}'
          class='{{ this_link_class }}'
          style='{{ this_link_style }}'
        >
          {% render 'typography',
            text: link.title,
            type_style: s.type_style,
            color_role: color_role,
            class: utility_classes
          %}
        </a>
      </li>
    {% endfor %}
  </ul>
</nav>

{% schema %}
{
  "name": "Header Nav",
  "settings": [
    {
      "type": "link_list",
      "id": "nav",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "space",
      "id": "padding_top",
      "label": "Padding Top",
      "default": "none"
    },
    {
      "type": "space",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": "none"
    },
    {
      "type": "space",
      "id": "padding_left",
      "label": "Padding Left",
      "default": "none"
    },
    {
      "type": "space",
      "id": "padding_right",
      "label": "Padding Right",
      "default": "none"
    },
    {
      "type": "select",
      "id": "border_mode",
      "label": "Border",
      "default": "none",
      "options": [
        {
          "value": "custom",
          "label": "Custom"
        },
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "select",
      "id": "border_role",
      "label": "Border Color",
      "default": "default",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "emphasis",
          "label": "Emphasis"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        }
      ],
      "conditional": "setting.border_mode != 'none'"
    },
    {
      "type": "palette",
      "id": "border_role_palette",
      "label": "Border Palette Token",
      "default": "brand",
      "conditional": "setting.border_role == 'palette' and setting.border_mode != 'none'"
    },
    {
      "type": "color",
      "id": "border_role_custom",
      "label": "Raw Border",
      "conditional": "setting.border_role == 'custom' and setting.border_mode != 'none'"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Border Style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "border_custom_left",
      "label": "Border Left",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_right",
      "label": "Border Right",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_top",
      "label": "Border Top",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_bottom",
      "label": "Border Bottom",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "select",
      "id": "border_size",
      "label": "Border Size",
      "options": [
        {
          "value": "xxs",
          "label": "XXS",
          "info": "1px"
        },
        {
          "value": "xs",
          "label": "XS",
          "info": "2px"
        },
        {
          "value": "sm",
          "label": "Small",
          "info": "4px"
        },
        {
          "value": "md",
          "label": "Medium",
          "info": "6px"
        },
        {
          "value": "lg",
          "label": "Large",
          "info": "8px"
        },
        {
          "value": "custom",
          "label": "Custom",
          "info": "Exact px width"
        }
      ],
      "default": "md",
      "conditional": "setting.border_mode != 'none'"
    },
    {
      "type": "range",
      "id": "border_size_custom",
      "label": "Custom Border Width",
      "min": 0,
      "max": 12,
      "step": 0.5,
      "default": 1,
      "unit": "px",
      "conditional": "setting.border_size == 'custom'"
    },
    {
      "type": "select",
      "id": "link_align",
      "label": "Link Vertical Align",
      "info": "Cross-axis alignment of each link and of the strip.",
      "default": "middle",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "baseline",
          "label": "Baseline"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "border_radius_override",
      "label": "Override Border Radius",
      "default": false,
      "conditional": "true"
    },
    {
      "type": "range",
