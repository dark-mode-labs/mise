{% assign s = block.settings %}

{%- capture bg_color_value -%}
  {%- render 'role-color-value', kind: 'bg', role: s.bg_role,
      palette: s.bg_role_palette, custom: s.bg_role_custom, gradient: s.bg_role_gradient -%}
{%- endcapture -%}
{% assign classes = 'slide-block w-[var(--slide-width)] md:w-[var(--slide-width-md)] flex-shrink-0 snap-start relative overflow-hidden flex flex-col' %}

{% if s.bg_role
  and s.bg_role != 'none'
  and s.bg_role != 'custom'
  and s.bg_role != 'palette'
  and s.bg_role != 'gradient'
%}
  {% assign classes = classes | push: 'bg-{{ s.bg_role }}' %}
{% endif %}

{% assign classes = classes | push_if: 'surface-{{ s.surface_id }}', s.surface_override %}
{% assign slide_classes = classes | join: ' ' %}

{% assign slide_styles = blank %}
{% if bg_color_value != blank %}
  {% assign slide_styles = slide_styles | push: 'background: {{ bg_color_value }}' %}
{% endif %}
{% assign slide_style_str = slide_styles | join: ';' %}

{% assign content_classes = 'wrapper relative z-content flex flex-col flex-auto gap-4'
  | push: 'section-align-content-{{ s.content_align }}'
  | push: 'section-align-v-{{ s.vertical_align }}'
  | push: 'section-align-text-{{ s.text_align }}'
%}

{% assign content_class_str = content_classes | join: ' ' %}

{% assign placeholder_name = '' %}
{% if s.show_placeholder %}
  {% assign placeholder_name = 'scene-1' %}
{% endif %}

<div
  class='{{ slide_classes }}'
  style='{{ slide_style_str }}'
  {{ context.attached_attributes }}
>
  <div class='absolute inset-0 z-media'>
    {% render 'media',
      src: s.image,
      src_mobile: s.image_mobile,
      video: s.video_url,
      fit: 'cover',
      placeholder: placeholder_name,
      effect: s.effect
    %}

    {% render 'bg-overlay',
      role: s.overlay_role,
      alpha: s.overlay_alpha,
      palette_token: s.overlay_role_palette,
      custom_color: s.overlay_role_custom,
      gradient_token: s.overlay_role_gradient
    %}
  </div>

  <div class='{{ content_class_str }}'>
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Slide",
  "settings": [
    {
      "type": "type_style",
      "id": "type_style",
      "label": "Type Style",
      "default": "body"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image"
    },
    {
      "type": "video_picker",
      "id": "video_url",
      "label": "Video URL (MP4)"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show Placeholder",
      "default": true,
      "info": "Show a pattern when no image is selected."
    },
    {
      "type": "effect",
      "id": "effect",
      "label": "Effects",
      "default": [],
      "info": "Effects applied to this element; several compose."
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "select",
      "id": "overlay_role",
      "label": "Overlay",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "body-alt",
          "label": "Body (alt)"
        },
        {
          "value": "surface",
          "label": "Surface"
        },
        {
          "value": "surface-alt",
          "label": "Surface (alt)"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "button",
          "label": "Button"
        },
        {
          "value": "control",
          "label": "Control"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "palette",
      "id": "overlay_role_palette",
      "label": "Overlay Palette Token",
      "default": "brand",
      "conditional": "setting.overlay_role == 'palette'"
    },
    {
      "type": "color",
      "id": "overlay_role_custom",
      "label": "Raw Overlay",
      "conditional": "setting.overlay_role == 'custom'"
    },
    {
      "type": "gradient",
      "id": "overlay_role_gradient",
      "label": "Overlay Gradient",
      "conditional": "setting.overlay_role == 'gradient'"
    },
    {
      "type": "range",
      "id": "overlay_alpha",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%",
      "conditional": "setting.overlay_role != 'none' and setting.overlay_role != 'custom'"
    },
    {
      "type": "header",
      "content": "Alignment"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical Alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "middle"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "bg_role",
      "label": "Background",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "body-alt",
          "label": "Body (alt)"
        },
        {
          "value": "surface",
          "label": "Surface"
        },
        {
          "value": "surface-alt",
          "label": "Surface (alt)"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "button",
          "label": "Button"
        },
        {
          "value": "control",
          "label": "Control"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "palette",
      "id": "bg_role_palette",
      "label": "Background Palette Token",
      "default": "brand",
      "conditional": "setting.bg_role == 'palette'"
    },
    {
      "type": "color",
      "id": "bg_role_custom",
      "label": "Raw Background",
      "conditional": "setting.bg_role == 'custom'"
    },
    {
      "type": "gradient",
      "id": "bg_role_gradient",
      "label": "Background Gradient",
      "conditional": "setting.bg_role == 'gradient'"
    },
    {
      "type": "header",
      "content": "Overrides",
      "conditional": "true"
    },
    {
      "type": "checkbox",
      "id": "surface_override",
      "label": "Override Color Scheme",
      "default": false,
      "conditional": "true"
    },
    {
      "type": "surface",
      "id": "surface_id",
      "label": "Color Scheme",
      "default": "default",
      "conditional": "setting.surface_override == true"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name": "Slide",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "content": "New Slide",
            "tag": "h1",
            "type_style": "display-1"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "label": "View Menu",
            "style": "primary"
          }
        }
      },
      "block_order": ["heading", "button"]
    }
  ]
}
{% endschema %}
