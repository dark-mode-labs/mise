{% assign s = block.settings %}

{% assign text_color_value = blank %}
{% if s.text_role == 'palette' and s.text_role_palette != blank %}
  {% assign text_color_value = 'var(--palette-{{ s.text_role_palette }})' %}
{% elsif s.text_role == 'custom' and s.text_role_custom != blank %}
  {% assign text_color_value = s.text_role_custom %}
{% endif %}
{% assign bg_color_value = blank %}
{% if s.bg_role == 'palette' and s.bg_role_palette != blank %}
  {% assign bg_color_value = 'var(--palette-{{ s.bg_role_palette }})' %}
{% elsif s.bg_role == 'gradient' and s.bg_role_gradient != blank %}
  {% assign bg_color_value = 'var(--gradient-{{ s.bg_role_gradient }})' %}
{% elsif s.bg_role == 'custom' and s.bg_role_custom != blank %}
  {% assign bg_color_value = s.bg_role_custom %}
{% endif %}
{% assign border_color_value = blank %}
{% if s.border_role == 'palette' and s.border_role_palette != blank %}
  {% assign border_color_value = 'var(--palette-{{ s.border_role_palette }})' %}
{% elsif s.border_role == 'gradient' and s.border_role_gradient != blank %}
  {% assign border_color_value = 'var(--gradient-{{ s.border_role_gradient }})' %}
{% elsif s.border_role == 'custom' and s.border_role_custom != blank %}
  {% assign border_color_value = s.border_role_custom %}
{% endif %}

{% assign radius_class = 'rounded-global' %}
{% if s.border_radius_override %}
  {% assign radius_class = 'rounded-custom' %}
{% endif %}

{% assign wrapper_classes = 'whitespace-nowrap relative'
  | push: radius_class
  | push: 'mt-{{ s.margin_top }} mb-{{ s.margin_bottom }}'
  | push: 'ml-{{ s.margin_left }} mr-{{ s.margin_right }}'
%}
{% if s.align_self != blank and s.align_self != 'auto' -%}
  {%- assign wrapper_classes = wrapper_classes | push: 'self-{{ s.align_self }}' -%}
{%- endif %}

{% assign wrapper_classes = wrapper_classes | push: 'block width-{{ s.width }} limit-width' %}

{% if s.height and s.height != 'auto' %}
  {% assign wrapper_classes = wrapper_classes | push: 'height-{{ s.height }}' %}
  {% assign inner_classes_height = 'height-full' %}
{% endif %}

{% if s.surface_override %}
  {% assign wrapper_classes = wrapper_classes | push: "surface-{{ s.surface_id | default: 'default' }}" %}
{% endif %}

{% unless s.border_mode == 'none' %}
  {% assign wrapper_classes = wrapper_classes
    | push: 'group-border-{{ s.border_mode }}'
    | push: 'group-border-size-{{ s.border_size }}'
  %}
  {% if s.border_role
    and s.border_role != 'none'
    and s.border_role != 'custom'
    and s.border_role != 'palette'
    and s.border_role != 'gradient'
  %}
    {% assign wrapper_classes = wrapper_classes | push: 'border-{{ s.border_role }}' %}
  {% endif %}
  {% if s.border_mode == 'custom' %}
    {% assign wrapper_classes = wrapper_classes
      | push_if: 'group-border-custom-left', s.border_custom_left
      | push_if: 'group-border-custom-right', s.border_custom_right
      | push_if: 'group-border-custom-top', s.border_custom_top
      | push_if: 'group-border-custom-bottom', s.border_custom_bottom
    %}
  {% endif %}
{% endunless %}

{% for ef_id in s.effect %}
  {% assign wrapper_classes = wrapper_classes | push: 'ef-{{ ef_id }}' %}
{% endfor %}

{% assign wrapper_class_str = wrapper_classes | join: ' ' %}

{% assign inner_classes = 'w-full flex' | push: radius_class | push: inner_classes_height %}
{%- comment -%} A link-style button is inline text — no button padding (it would indent the link). {%- endcomment -%}
{% unless s.style == 'link' %}
  {% assign inner_classes = inner_classes
    | push: 'pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}'
    | push: 'pl-{{ s.padding_left }} pr-{{ s.padding_right }}'
  %}
{% endunless %}

{% case s.style %}
  {% when 'outline' -%}
    {%- assign inner_classes = inner_classes | push: 'btn-outline' %}
  {% when 'link' -%}
    {%- assign inner_classes = inner_classes | push: 'btn-link' %}
  {% else -%}
    {%- assign inner_classes = inner_classes | push: 'btn-primary' %}
    {% assign btn_slot_roles = 'body,body-alt,surface,surface-alt,accent,control' | split: ',' %}
    {% if btn_slot_roles contains s.bg_role %}
      {%- assign inner_classes = inner_classes | push: 'bg-{{ s.bg_role }}' %}
    {% endif %}
{% endcase %}

{% case s.content_align %}
  {% when 'center' -%}
    {%- assign inner_classes = inner_classes | push: 'justify-content-center' %}
  {% when 'right' -%}
    {%- assign inner_classes = inner_classes | push: 'justify-content-end' %}
  {% when 'between' -%}
    {%- assign inner_classes = inner_classes | push: 'justify-content-between' %}
  {% else -%}
    {%- assign inner_classes = inner_classes | push: 'justify-content-start' %}
{% endcase %}

{% case s.vertical_align %}
  {% when 'top' -%}
    {%- assign inner_classes = inner_classes | push: 'align-items-start' %}
  {% when 'middle' -%}
    {%- assign inner_classes = inner_classes | push: 'align-items-center' %}
  {% when 'bottom' -%}
    {%- assign inner_classes = inner_classes | push: 'align-items-end' %}
  {% when 'baseline' -%}
    {%- assign inner_classes = inner_classes | push: 'align-items-baseline' %}
  {% else -%}
    {%- assign inner_classes = inner_classes | push: 'align-items-stretch' %}
{% endcase %}

{% assign inner_class_str = inner_classes | join: ' ' %}

{% assign styles = blank %}

{% unless s.border_mode == 'none' %}
  {% assign styles = styles | push: '--border-style: {{ s.border_style }}' %}
  {% if s.border_size == 'custom' %}
    {% assign styles = styles | push: '--border-width: {{ s.border_size_custom }}px' %}
  {% endif %}
  {% if border_color_value != blank -%}
    {%- assign styles = styles | push: '--border: {{ border_color_value }}' -%}
  {%- endif %}
{% endunless %}

{% assign styles = styles | push_if: '--radius-custom: {{ s.border_radius }}px', s.border_radius_override %}
{% if bg_color_value != blank %}{% assign styles = styles | push: '--button-bg: {{ bg_color_value }}' %}{% endif %}
{% if text_color_value != blank -%}
  {%- assign styles = styles | push: '--text-on-button: {{ text_color_value }}' -%}
{%- endif %}
{% if s.underline and s.underline_offset > 0 %}
  {%- assign styles = styles | push: 'text-underline-offset: {{ s.underline_offset }}rem' -%}
{% endif %}
{% assign wrapper_style_str = styles | join: ';' %}

{% comment %} --- 4. Typography Utilities & Config --- {% endcomment %}
{% assign utilities = blank %}

{% case s.text_wrap %}
  {% when 'wrap' -%}
    {%- assign utilities = utilities | push: 'whitespace-normal' %}
  {% when 'nowrap' -%}
    {%- assign utilities = utilities | push: 'whitespace-nowrap' %}
  {% when 'balance' -%}
    {%- assign utilities = utilities | push: 'text-balance' %}
{% endcase %}

{% case s.overflow_behavior %}
  {% when 'hidden' -%}
    {%- assign utilities = utilities | push: 'overflow-hidden' %}
  {% when 'ellipsis' -%}
    {%- assign utilities = utilities | push: 'truncate' %}
{% endcase %}

{% if s.underline %}{%- assign utilities = utilities | push: 'underline' %}{% endif %}

{% assign utility_classes = utilities | join: ' ' %}

{% assign color_role = s.text_role %}
{% if s.text_role == 'custom' or s.text_role == 'palette' %}
  {% assign color_role = 'on-button' %}
{% endif %}

<div
  class='{{ wrapper_class_str }}'
  style='{{ wrapper_style_str }}'
  {{ context.attached_attributes }}
>
  {% if s.trigger == 'action' %}
    <button
      type='button'
      class='{{ inner_class_str }}'
      data-action='{{ s.action | escape }}'
      {% if s.action_args != blank %}
        data-action-args='{{ s.action_args | escape }}'
      {% endif %}
    >
      {% render 'typography', text: s.label, type_style: s.type_style, color_role: color_role, class: utility_classes %}
    </button>
  {% elsif s.trigger == 'link' %}
    <a
      href='{{ s.link }}'
      {% if s.link == blank %}
        inert='true'
      {% endif %}
      {% if s.link_target == '_blank' %}
        target='_blank' rel='noopener'
      {% endif %}
      class='{{ inner_class_str }}'
    >
      {% render 'typography', type_style: s.type_style, text: s.label, color_role: color_role, class: utility_classes %}
    </a>
  {% endif %}
</div>
{% schema %}
{
  "name": "Button",
  "settings": [
    {
      "type": "select",
      "id": "align_self",
      "label": "Align Self",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "start",
          "label": "Top / Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom / End"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Book Now"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "primary",
      "options": [
        {
          "value": "primary",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "select",
      "id": "bg_role",
      "label": "Button Background",
      "default": "button",
      "options": [
        {
          "value": "button",
          "label": "Button"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "body-alt",
          "label": "Body (alt)"
        },
        {
          "value": "surface",
          "label": "Surface"
        },
        {
          "value": "surface-alt",
          "label": "Surface (alt)"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "control",
          "label": "Control"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "conditional": "setting.style == 'primary'"
    },
    {
      "type": "palette",
      "id": "bg_role_palette",
      "label": "Background Palette Token",
      "default": "brand",
      "conditional": "setting.bg_role == 'palette' and setting.style == 'primary'"
    },
    {
      "type": "color",
      "id": "bg_role_custom",
      "label": "Raw Background",
      "conditional": "setting.bg_role == 'custom' and setting.style == 'primary'"
    },
    {
      "type": "gradient",
      "id": "bg_role_gradient",
      "label": "Background Gradient",
      "conditional": "setting.bg_role == 'gradient'"
    },
    {
      "type": "header",
      "content": "Trigger"
    },
    {
      "type": "select",
      "id": "trigger",
      "label": "Trigger",
      "default": "link",
      "options": [
        {
          "value": "link",
          "label": "Link"
        },
        {
          "value": "action",
          "label": "Action"
        }
      ]
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "conditional": "setting.trigger == 'link'"
    },
    {
      "type": "select",
      "id": "link_target",
      "label": "Open link in",
      "options": [
        {
          "value": "_blank",
          "label": "New Tab"
        },
        {
          "value": "_self",
          "label": "Current Tab"
        }
      ],
      "default": "_self",
      "conditional": "setting.trigger == 'link'"
    },
    {
      "type": "text",
      "id": "action",
      "label": "Action Type",
      "conditional": "setting.trigger == 'action'"
    },
    {
      "type": "text",
      "id": "action_args",
      "label": "Action Arguments",
      "conditional": "setting.trigger == 'action'"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "type_style",
      "id": "type_style",
      "label": "Type Style",
      "default": "button"
    },
    {
      "type": "select",
      "id": "text_wrap",
      "label": "Text Wrapping",
      "default": "wrap",
      "options": [
        {
          "value": "wrap",
          "label": "Wrap"
        },
        {
          "value": "nowrap",
          "label": "No Wrap"
        },
        {
          "value": "balance",
          "label": "Balance"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "underline",
      "label": "Underline",
      "default": false
    },
    {
      "type": "range",
      "id": "underline_offset",
      "label": "Underline offset",
      "min": 0,
      "max": 0.5,
      "step": 0.0625,
      "default": 0,
      "unit": "rem",
      "conditional": "setting.underline == true"
    },
    {
      "type": "select",
      "id": "overflow_behavior",
      "label": "Overflow",
      "default": "visible",
      "options": [
        {
          "value": "visible",
          "label": "Visible"
        },
        {
          "value": "hidden",
          "label": "Hidden (Clip)"
        },
        {
          "value": "ellipsis",
          "label": "Ellipsis (Truncate)"
        }
      ]
    },
    {
      "type": "header",
      "content": "Borders"
    },
    {
      "type": "select",
      "id": "border_mode",
      "label": "Border",
      "default": "none",
      "options": [
        {
          "value": "custom",
          "label": "Custom"
        },
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "select",
      "id": "border_role",
      "label": "Border Color",
      "default": "default",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "emphasis",
          "label": "Emphasis"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "conditional": "setting.border_mode != 'none'"
    },
    {
      "type": "palette",
      "id": "border_role_palette",
      "label": "Border Palette Token",
      "default": "brand",
      "conditional": "setting.border_role == 'palette' and setting.border_mode != 'none'"
    },
    {
      "type": "color",
      "id": "border_role_custom",
      "label": "Raw Border",
      "conditional": "setting.border_role == 'custom' and setting.border_mode != 'none'"
    },
    {
      "type": "gradient",
      "id": "border_role_gradient",
      "label": "Border Gradient",
      "conditional": "setting.border_role == 'gradient'"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Border Style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "border_custom_left",
      "label": "Border Left",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_right",
      "label": "Border Right",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_top",
      "label": "Border Top",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_bottom",
      "label": "Border Bottom",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "select",
      "id": "border_size",
      "label": "Border Size",
      "options": [
        {
          "value": "xxs",
          "label": "XXS",
          "info": "1px"
        },
        {
          "value": "xs",
          "label": "XS",
          "info": "2px"
        },
        {
          "value": "sm",
          "label": "Small",
          "info": "4px"
        },
        {
          "value": "md",
          "label": "Medium",
          "info": "6px"
        },
        {
          "value": "lg",
          "label": "Large",
          "info": "8px"
        },
        {
          "value": "custom",
          "label": "Custom",
          "info": "Exact px width"
        }
      ],
      "default": "md",
      "conditional": "setting.border_mode != 'none'"
    },
    {
      "type": "range",
      "id": "border_size_custom",
      "label": "Custom Border Width",
      "min": 0,
      "max": 12,
      "step": 0.5,
      "default": 1,
      "unit": "px",
      "conditional": "setting.border_size == 'custom'"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "width",
      "id": "width",
      "label": "Width",
      "default": "fit"
    },
    {
      "type": "height",
      "id": "height",
      "label": "Height",
      "default": "auto"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Horizontal Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left / Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right / End"
        },
        {
          "value": "between",
          "label": "Space Between"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical Alignment",
      "options": [
        {
          "value": "top",
          "label": "Top / Start"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom / End"
        },
        {
          "value": "baseline",
          "label": "Baseline"
        },
        {
          "value": "between",
          "label": "Space Between"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "space",
      "id": "padding_top",
      "label": "Padding Top",
      "default": "xs"
    },
    {
      "type": "space",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": "xs"
    },
    {
      "type": "space",
      "id": "padding_left",
      "label": "Padding Left",
      "default": "md"
    },
    {
      "type": "space",
      "id": "padding_right",
      "label": "Padding Right",
      "default": "md"
    },
    {
      "type": "space",
      "id": "margin_top",
      "label": "Margin Top",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_left",
      "label": "Margin Left",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_right",
      "label": "Margin Right",
      "default": "none"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "text_role",
      "label": "Text Color Role",
      "default": "on-button",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit"
        },
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "emphasis",
          "label": "Emphasis"
        },
        {
          "value": "on-accent",
          "label": "On Accent"
        },
        {
          "value": "on-button",
          "label": "On Button"
        },
        {
          "value": "on-control",
          "label": "On Control"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        }
      ]
    },
    {
      "type": "palette",
      "id": "text_role_palette",
      "label": "Text Palette Token",
      "default": "brand",
      "conditional": "setting.text_role == 'palette'"
    },
    {
      "type": "color",
      "id": "text_role_custom",
      "label": "Raw Text Color",
      "conditional": "setting.text_role == 'custom'"
    },
    {
      "type": "effect",
      "id": "effect",
      "label": "Effects",
      "default": [],
      "info": "Effects applied to this element; several compose."
    },
    {
      "type": "header",
      "content": "Overrides",
      "conditional": "true"
    },
    {
      "type": "checkbox",
      "id": "surface_override",
      "label": "Override Color Scheme",
      "default": false,
      "conditional": "true"
    },
    {
      "type": "surface",
      "id": "surface_id",
      "label": "Color Scheme",
      "default": "default",
      "conditional": "setting.surface_override == true"
    },
    {
      "type": "checkbox",
      "id": "border_radius_override",
      "label": "Override Border Radius",
      "default": false,
      "conditional": "true"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Custom Border Radius",
      "min": 0,
      "max": 1000,
      "default": 4,
      "unit": "px",
      "conditional": "setting.border_radius_override"
    }
  ]
}
{% endschema %}
