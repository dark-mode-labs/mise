{% assign s = block.settings %}

{% comment %} --- Wrapper Classes --- {% endcomment %}
{% assign radius_class = 'rounded-global' %}
{% if s.border_radius_override %}
  {% assign radius_class = 'rounded-custom' %}
{% endif %}
{% assign classes = 'media-block relative overflow-hidden limit-width'
  | push: radius_class
  | push: 'width-{{ s.width | default: "fill" }}'
  | push: 'height-{{ s.height }}'
  | push: 'mt-{{ s.margin_top }} mb-{{ s.margin_bottom }}'
  | push: 'ml-{{ s.margin_left }} mr-{{ s.margin_right }}'
%}
{% if s.align_self != blank and s.align_self != 'auto' -%}
  {%- assign classes = classes | push: 'self-{{ s.align_self }}' -%}
{%- endif %}

{% assign classes = classes | push_if: "surface-{{ s.surface_id | default: 'default' }}", s.surface_override %}
{% assign block_classes = classes | join: ' ' %}

{% comment %} --- Styles Array Building --- {% endcomment %}
{% assign styles = blank %}

{% assign styles = styles | push_if: '--radius-custom: {{ s.border_radius }}px', s.border_radius_override %}

{% assign block_styles = styles | join: ';' %}

{% comment %} --- Component Render --- {% endcomment %}
<div
  class='{{ block_classes }}'
  style='{{ block_styles }}'
  {{ context.attached_attributes }}
>
  {% render 'media',
    src: s.image,
    src_mobile: s.image_mobile,
    video: s.video_url,
    ratio: s.aspect_ratio,
    ratio_custom: s.aspect_ratio_custom,
    fit: s.object_fit,
    position: s.object_position,
    effect: s.effect,
    controls: s.show_controls,
    autoplay: s.autoplay,
    placeholder: 'scene-1'
  %}
</div>

{% schema %}
{
  "name": "Media (Image/Video)",
  "settings": [
    {
      "type": "select",
      "id": "align_self",
      "label": "Align Self",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "start",
          "label": "Top / Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom / End"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image"
    },
    {
      "type": "video_picker",
      "id": "video_url",
      "label": "Video URL (MP4)"
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show Video Controls",
      "default": false,
      "conditional": "setting.video_url != blank"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay Video",
      "default": false,
      "conditional": "setting.video_url != blank"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "width",
      "id": "width",
      "label": "Width",
      "default": "fill"
    },
    {
      "type": "height",
      "id": "height",
      "label": "Image Height",
      "default": "auto"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect Ratio",
      "options": [
        {
          "value": "auto",
          "label": "Natural"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "video",
          "label": "Video (16:9)"
        },
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "auto"
    },
    {
      "type": "text",
      "id": "aspect_ratio_custom",
      "label": "Custom Aspect Ratio",
      "default": "",
      "info": "CSS aspect-ratio value, e.g. 4/5.",
      "conditional": "setting.aspect_ratio == 'custom'"
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Object Fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover (Fill)"
        },
        {
          "value": "contain",
          "label": "Contain (Fit)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "text",
      "id": "object_position",
      "label": "Focal Point",
      "default": ""
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "space",
      "id": "margin_top",
      "label": "Margin Top",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_left",
      "label": "Margin Left",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_right",
      "label": "Margin Right",
      "default": "none"
    },
    {
      "type": "effect",
      "id": "effect",
      "label": "Effects",
      "default": [],
      "info": "Effects applied to this element; several compose."
    },
    {
      "type": "header",
      "content": "Overrides",
      "conditional": "true"
    },
    {
      "type": "checkbox",
      "id": "surface_override",
      "label": "Override Color Scheme",
      "default": false,
      "conditional": "true"
    },
    {
      "type": "surface",
      "id": "surface_id",
      "label": "Color Scheme",
      "default": "default",
      "conditional": "setting.surface_override == true"
    },
    {
      "type": "checkbox",
      "id": "border_radius_override",
      "label": "Override Border Radius",
      "default": false,
      "conditional": "true"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Custom Radius",
      "min": 0,
      "max": 1000,
      "default": 0,
      "unit": "px",
      "conditional": "setting.border_radius_override"
    }
  ],
  "presets": [
    {
      "name": "Media"
    }
  ]
}
{% endschema %}
