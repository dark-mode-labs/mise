{% assign s = block.settings %}

{% assign classes = 'footer-block' %}
{% if s.align_self != blank and s.align_self != 'auto' -%}
  {%- assign classes = classes | push: 'self-{{ s.align_self }}' -%}
{%- endif %}

{% if s.width and s.width != blank %}
  {% assign classes = classes | push: 'width-{{ s.width }}' %}
{% endif %}

{% if s.text_align != blank and s.text_align != 'inherit' %}
  {% assign classes = classes | push: 'text-align-{{ s.text_align }}' %}
{% endif %}

{% if s.surface_override %}
  {% assign classes = classes | push: "surface-{{ s.surface_id | default: 'default' }}" %}
{% endif %}

{% assign block_classes = classes | join: ' ' %}

{%- capture text_color_value -%}
  {%- render 'role-color-value', kind: 'text', role: s.text_role,
      palette: s.text_role_palette, custom: s.text_role_custom -%}
{%- endcapture -%}
{% assign styles = blank %}
{% if text_color_value != blank %}
  {% assign styles = styles | push: '--text: {{ text_color_value }}' %}
{% endif %}
{% assign block_styles = styles | join: ';' %}

{% assign utilities = blank %}

{% case s.text_wrap %}
  {% when 'nowrap' %}
    {% assign utilities = utilities | push: 'whitespace-nowrap' %}
  {% when 'balance' %}
    {% assign utilities = utilities | push: 'text-balance' %}
{% endcase %}

{% assign utility_classes = utilities | join: ' ' %}

{% assign color_role = s.text_role %}
{% if s.text_role == 'custom' or s.text_role == 'palette' %}{% assign color_role = 'primary' %}{% endif %}
<div
  class='{{ block_classes }}'
  style='{{ block_styles }}'
  {{ context.attached_attributes }}
>
  <details class='group' open>
    {% assign summary_classes = 'list-none footer-nav-summary'
      | push: 'flex direction-row vertical-{{ s.heading_align }}'
      | push: 'content-{{ s.heading_distribute }}'
      | push: 'mb-{{ s.heading_margin_bottom }}'
    %}
    <summary class='{{ summary_classes | join: ' ' }}'>
      {% render 'typography',
        text: s.heading,
        type_style: s.type_style,
        class: utility_classes,
        color_role: color_role
      %}
      {%- capture icon_color_class -%}{%- render 'text-color-class', color_role: color_role -%}{%- endcapture -%}
      {% render 'icon',
        name: 'chevron-right',
        class: 'w-4 h-4 transition-transform group-open:rotate-90 md:hidden {{ icon_color_class }}'
      %}
    </summary>

    {% content_for 'blocks' %}
  </details>
</div>

{% schema %}
{
  "name": "Nav Group",
  "restriction": {
    "groups": ["footer"]
  },
  "blocks": [
    {
      "type": "_nav-group"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "align_self",
      "label": "Align Self",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "start",
          "label": "Top / Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom / End"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Vertical Align",
      "default": "middle",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "baseline",
          "label": "Baseline"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_distribute",
      "label": "Heading Distribution",
      "default": "between",
      "info": "Where the disclosure marker sits against the heading.",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "between",
          "label": "Between"
        },
        {
          "value": "around",
          "label": "Around"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "space",
      "id": "heading_margin_bottom",
      "label": "Heading Margin Bottom",
      "default": "sm"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quick Links"
    },
    {
      "type": "width",
      "id": "width",
      "label": "Width"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "type_style",
      "id": "type_style",
      "label": "Type Style",
      "default": "nav"
    },
    {
      "type": "select",
      "id": "text_wrap",
      "label": "Text Wrapping",
      "default": "nowrap",
      "options": [
        {
          "value": "wrap",
          "label": "Wrap"
        },
        {
          "value": "nowrap",
          "label": "No Wrap"
        },
        {
          "value": "balance",
          "label": "Balance"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_role",
      "label": "Text Color Role",
      "default": "primary",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "emphasis",
          "label": "Emphasis"
        },
        {
          "value": "on-accent",
          "label": "On Accent"
        },
        {
          "value": "on-button",
          "label": "On Button"
        },
        {
          "value": "on-control",
          "label": "On Control"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        }
      ]
    },
    {
      "type": "palette",
      "id": "text_role_palette",
      "label": "Text Palette Token",
      "default": "brand",
      "conditional": "setting.text_role == 'palette'"
    },
    {
      "type": "color",
      "id": "text_role_custom",
      "label": "Raw Text Color",
      "conditional": "setting.text_role == 'custom'"
    },
    {
      "type": "header",
      "content": "Overrides",
      "conditional": "true"
    },
    {
      "type": "checkbox",
      "id": "surface_override",
      "label": "Override Color Scheme",
      "default": false,
      "conditional": "true"
    },
    {
      "type": "surface",
      "id": "surface_id",
      "label": "Color Scheme",
      "default": "default",
      "conditional": "setting.surface_override == true"
    }
  ]
}
{% endschema %}
