{% assign s = section.settings %}

{%- capture bg_color_value -%}
  {%- render 'role-color-value', kind: 'bg', role: s.bg_role,
      palette: s.bg_role_palette, custom: s.bg_role_custom, gradient: s.bg_role_gradient -%}
{%- endcapture -%}

{% assign surface_safe = s.surface_id | default: 'default' %}
{% assign bg_role_safe = s.bg_role | default: 'none' %}
{% assign bg_class = '' %}
{% if bg_color_value == blank and bg_role_safe != 'none' %}
  {% assign bg_class = 'bg-' | append: bg_role_safe %}
{% endif %}

{% assign margin_styles = blank %}

{% assign bg_layer_styles = blank %}
{% if bg_color_value != blank %}
  {% assign bg_layer_styles = bg_layer_styles | push: 'background: {{ bg_color_value }}' %}
{% endif %}

{%- capture border_class_str -%}{%- render 'box-border-class',
  mode: s.border_mode, role: s.border_role, size_tier: s.border_size,
  custom_left: s.border_custom_left, custom_right: s.border_custom_right,
  custom_top: s.border_custom_top, custom_bottom: s.border_custom_bottom -%}{%- endcapture -%}
{%- capture border_style_str -%}{%- render 'box-border-style',
  mode: s.border_mode, role: s.border_role, palette_token: s.border_role_palette,
  gradient_token: s.border_role_gradient, custom_color: s.border_role_custom,
  style: s.border_style, size_tier: s.border_size, size_custom: s.border_size_custom -%}{%- endcapture -%}
{% if border_style_str != blank %}{% assign bg_layer_styles = bg_layer_styles | push: border_style_str %}{% endif %}

<section
  class='tabs-section surface-{{ surface_safe }} relative isolate mt-{{ s.margin_top }} mb-{{ s.margin_bottom }} ml-{{ s.margin_left }} mr-{{ s.margin_right }}'
  style='{{ margin_styles | join: ';' }}'
  {{ context.attached_attributes }}
>
  <div
    class='tabs-bg-layer relative limit-width width-{{ s.width_bg }} {{ bg_class }} {{ border_class_str }} pt-{{ s.padding_top }} pb-{{ s.padding_bottom }} pl-{{ s.padding_left }} pr-{{ s.padding_right }}'
    style='{{ bg_layer_styles | join: ';' }}'
  >
    {% content_for 'blocks' %}
  </div>
</section>
{% schema %}
{
  "name": "Tabs",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "width",
      "id": "width_bg",
      "label": "Background Width",
      "default": "fill"
    },
    {
      "type": "space",
      "id": "padding_top",
      "label": "Padding Top",
      "default": "sm"
    },
    {
      "type": "space",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": "sm"
    },
    {
      "type": "space",
      "id": "padding_left",
      "label": "Padding Left",
      "default": "sm"
    },
    {
      "type": "space",
      "id": "padding_right",
      "label": "Padding Right",
      "default": "sm"
    },
    {
      "type": "space",
      "id": "margin_top",
      "label": "Margin Top",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_left",
      "label": "Margin Left",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_right",
      "label": "Margin Right",
      "default": "none"
    },
    {
      "type": "header",
      "content": "Theme"
    },
    {
      "type": "surface",
      "id": "surface_id",
      "label": "Color Scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "bg_role",
      "label": "Background",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "body-alt",
          "label": "Body (alt)"
        },
        {
          "value": "surface",
          "label": "Surface"
        },
        {
          "value": "surface-alt",
          "label": "Surface (alt)"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "button",
          "label": "Button"
        },
        {
          "value": "control",
          "label": "Control"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "palette",
      "id": "bg_role_palette",
      "label": "Background Palette Token",
      "default": "brand",
      "conditional": "setting.bg_role == 'palette'"
    },
    {
      "type": "color",
      "id": "bg_role_custom",
      "label": "Raw Background",
      "conditional": "setting.bg_role == 'custom'"
    },
    {
      "type": "gradient",
      "id": "bg_role_gradient",
      "label": "Background Gradient",
      "conditional": "setting.bg_role == 'gradient'"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "select",
      "id": "border_mode",
      "label": "Border",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "full", "label": "Full" },
        { "value": "custom", "label": "Custom" }
      ]
    },
    {
      "type": "select",
      "subtype": "border_role",
      "id": "border_role",
      "label": "Border Color",
      "default": "default",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "default", "label": "Default" },
        { "value": "emphasis", "label": "Emphasis" },
        { "value": "palette", "label": "Base Palette" },
        { "value": "custom", "label": "Raw Color" }
      ]
    },
    {
      "type": "palette",
      "id": "border_role_palette",
      "label": "Border Palette Token",
      "default": "brand",
      "conditional": "setting.border_role == 'palette' and setting.border_mode != 'none'"
    },
    {
      "type": "color",
      "id": "border_role_custom",
      "label": "Raw Border",
      "conditional": "setting.border_role == 'custom' and setting.border_mode != 'none'"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Border Style",
      "default": "solid",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" }
      ],
      "conditional": "setting.border_mode != 'none'"
    },
    {
      "type": "select",
      "subtype": "border_size",
      "id": "border_size",
      "label": "Border Size",
      "default": "xxs",
      "options": [
        { "value": "xxs", "label": "XXS", "info": "1px" },
        { "value": "xs", "label": "XS", "info": "2px" },
        { "value": "sm", "label": "SM", "info": "4px" },
        { "value": "custom", "label": "Custom" }
      ],
      "conditional": "setting.border_mode != 'none'"
    },
    {
      "type": "range",
      "id": "border_size_custom",
      "label": "Custom Border Width",
      "min": 0,
      "max": 12,
      "step": 0.5,
      "default": 1,
      "unit": "px",
      "conditional": "setting.border_size == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_left",
      "label": "Border Left",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_right",
      "label": "Border Right",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_top",
      "label": "Border Top",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_bottom",
      "label": "Border Bottom",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    }
  ],
  "blocks": [
    {
      "type": "tab-group"
    },
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name": "Tabs",
      "settings": {},
      "blocks": {
        "tab-group": {
          "type": "tab-group"
        }
      },
      "block_order": ["tab-group"]
    }
  ]
}
{% endschema %}
