{% assign s = section.settings %}

{% assign bg_color_value = blank %}
{% if s.bg_role == 'palette' and s.bg_role_palette != blank %}
  {% assign bg_color_value = 'var(--palette-{{ s.bg_role_palette }})' %}
{% elsif s.bg_role == 'gradient' and s.bg_role_gradient != blank %}
  {% assign bg_color_value = 'var(--gradient-{{ s.bg_role_gradient }})' %}
{% elsif s.bg_role == 'custom' and s.bg_role_custom != blank %}
  {% assign bg_color_value = s.bg_role_custom %}
{% endif %}
{% assign has_media_2 = false %}
{% if s.bg_image_2 != blank or s.video_url_2 != blank %}
  {% assign has_media_2 = true %}
{% endif %}

{% assign bg_class = 'bg-{{ s.bg_role }}' %}
{% if bg_color_value != blank %}{% assign bg_class = '' %}{% endif %}

{% assign layout_classes = 'overflow-hidden limit-width'
  | push: bg_class
  | push: 'width-{{ s.width_bg }}'
  | push: 'height-{{ s.height }}'
%}
{% case s.layout_mode %}
  {% when 'split_right' %}
    {% assign layout_classes = layout_classes | push: 'hero-layout-split-right' %}
    {% assign media_classes = 'hero-media-split' %}
    {% assign content_classes = 'hero-content-split' %}
  {% when 'split_left' %}
    {% assign layout_classes = layout_classes | push: 'hero-layout-split-left' %}
    {% assign media_classes = 'hero-media-split' %}
    {% assign content_classes = 'hero-content-split' %}
  {% else %}
    {% assign layout_classes = layout_classes | push: 'hero-layout-overlay' %}
    {% assign media_classes = 'hero-media-overlay' %}
    {% assign content_classes = 'hero-content-overlay' %}
{% endcase %}

{% assign layout_classes = layout_classes
  | push: 'pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}'
  | push: 'pl-{{ s.padding_left }} pr-{{ s.padding_right }}'
%}

{% assign styles = blank %}
{% if bg_color_value != blank %}
  {% assign styles = styles | push: 'background: {{ bg_color_value }}' %}
{% endif %}
{% assign layout_class_str = layout_classes | join: ' ' %}
{% assign style_str = styles | join: ';' %}

{% assign margin_styles = blank %}
{% assign margin_style_str = margin_styles | join: ';' %}

{% assign content_pipeline = content_classes
  | push: 'width-{{ s.width }}'
  | push: 'limit-width gap-6 transition-all'
  | push: 'section-align-content-{{ s.content_align }}'
  | push: 'section-align-v-{{ s.vertical_align }}'
  | push: 'section-align-text-{{ s.text_align }}'
%}
{% if s.animation_delay != blank and s.animation_delay != 'none' %}
  {% assign content_pipeline = content_pipeline | push: 'stagger-load' | push: 'anim-delay-{{ s.animation_delay }}' %}
{% endif %}

{% assign content_class_str = content_pipeline | join: ' ' %}

{% assign placeholder_name = '' %}
{% if s.show_placeholder %}{% assign placeholder_name = 'scene-3' %}{% endif %}

<section
  class='section-hero surface-{{ s.surface_id }} mt-{{ s.margin_top }} mb-{{ s.margin_bottom }} ml-{{ s.margin_left }} mr-{{ s.margin_right }}'
  style='{{ margin_style_str }}'
  {{ context.attached_attributes }}
>
  <div
    class='{{ layout_class_str }}'
    style='{{ style_str }}'
  >
    <div class='{{ media_classes }}'>
      {% if has_media_2 %}
        {% assign media_1_classes = 'hero-media-inner relative w-1/2 border-r border-default' %}
      {% else %}
        {% assign media_1_classes = 'hero-media-inner absolute inset-0' %}
      {% endif %}

      <div class='{{ media_1_classes }}'>
        {% render 'media',
          src: s.bg_image,
          src_mobile: s.mobile_image,
          video: s.video_url,
          fit: 'cover',
          position: s.bg_focal,
          loading: 'eager',
          placeholder: placeholder_name,
          animation: s.animation,
          animation_speed: s.animation_speed,
          animation_loop: s.animation_loop,
          animation_intensity: s.animation_intensity
        %}

        {% render 'bg-overlay',
          role: s.overlay_role,
          alpha: s.overlay_alpha,
          palette_token: s.overlay_role_palette,
          custom_color: s.overlay_role_custom,
          gradient_token: s.overlay_role_gradient
        %}
      </div>

      {% if has_media_2 %}
        <div class='hero-media-inner w-1/2'>
          {% render 'media',
            src: s.bg_image_2,
            src_mobile: s.mobile_image_2,
            video: s.video_url_2,
            fit: 'cover',
            loading: 'eager',
            placeholder: placeholder_name,
            animation: s.animation,
            animation_speed: s.animation_speed,
            animation_loop: s.animation_loop,
            animation_intensity: s.animation_intensity
          %}
          {% render 'bg-overlay',
            role: s.overlay_role,
            alpha: s.overlay_alpha,
            palette_token: s.overlay_role_palette,
            custom_color: s.overlay_role_custom,
            gradient_token: s.overlay_role_gradient
          %}
        </div>
      {% endif %}
    </div>

    <div class='{{ content_class_str }}'>
      {% content_for 'blocks' %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "width",
      "id": "width_bg",
      "label": "Background Width",
      "default": "fill"
    },
    {
      "type": "width",
      "id": "width",
      "label": "Content Width",
      "default": "fill"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout Style",
      "options": [
        {
          "value": "overlay",
          "label": "Overlay (Classic)"
        },
        {
          "value": "split_left",
          "label": "Split (Media Left)"
        },
        {
          "value": "split_right",
          "label": "Split (Media Right)"
        }
      ],
      "default": "overlay"
    },
    {
      "type": "height",
      "id": "height",
      "label": "Image Height",
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "space",
      "id": "padding_top",
      "label": "Padding Top",
      "default": "none"
    },
    {
      "type": "space",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": "none"
    },
    {
      "type": "space",
      "id": "padding_left",
      "label": "Padding Left",
      "default": "none"
    },
    {
      "type": "space",
      "id": "padding_right",
      "label": "Padding Right",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_top",
      "label": "Margin Top",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_left",
      "label": "Margin Left",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_right",
      "label": "Margin Right",
      "default": "none"
    },
    {
      "type": "header",
      "content": "Primary Media"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Image 1 (Desktop)"
    },
    {
      "type": "text",
      "id": "bg_focal",
      "label": "Image Focal Point"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image 1 (Mobile)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video 1 (MP4)"
    },
    {
      "type": "header",
      "content": "Secondary Media"
    },
    {
      "type": "image_picker",
      "id": "bg_image_2",
      "label": "Image 2 (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_2",
      "label": "Image 2 (Mobile)"
    },
    {
      "type": "text",
      "id": "video_url_2",
      "label": "Video 2 (MP4)"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show Placeholder",
      "default": true,
      "info": "Show a pattern when no image is selected.",
      "conditional": "setting.bg_image == blank and setting.bg_image_2 == blank"
    },
    {
      "type": "header",
      "content": "Alignment"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical Alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "middle"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Media Animation",
      "info": "Motion applied to the hero background media.",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade-in", "label": "Fade In" },
        { "value": "rise-in", "label": "Rise In" },
        { "value": "zoom-in", "label": "Zoom In" },
        { "value": "float", "label": "Float" },
        { "value": "pulse", "label": "Pulse" },
        { "value": "ken-burns", "label": "Ken Burns" },
        { "value": "rise", "label": "Rise (drift)" },
        { "value": "shimmer", "label": "Shimmer" },
        { "value": "spin", "label": "Spin" },
        { "value": "bounce", "label": "Bounce" }
      ]
    },
    {
      "type": "select",
      "id": "animation_speed",
      "label": "Speed",
      "default": "normal",
      "conditional": "setting.animation != 'none'",
      "options": [
        { "value": "slow", "label": "Slow" },
        { "value": "normal", "label": "Normal" },
        { "value": "fast", "label": "Fast" }
      ]
    },
    {
      "type": "select",
      "id": "animation_loop",
      "label": "Loop",
      "default": "once",
      "conditional": "setting.animation != 'none'",
      "options": [
        { "value": "once", "label": "Once" },
        { "value": "loop", "label": "Loop" },
        { "value": "loop-alternate", "label": "Loop (alternate)" }
      ]
    },
    {
      "type": "select",
      "id": "animation_intensity",
      "label": "Intensity",
      "default": "normal",
      "conditional": "setting.animation != 'none'",
      "options": [
        { "value": "subtle", "label": "Subtle" },
        { "value": "normal", "label": "Normal" },
        { "value": "strong", "label": "Strong" }
      ]
    },
    {
      "type": "select",
      "id": "animation_delay",
      "label": "Stagger Content",
      "info": "Reveals hero content blocks with an incremental delay.",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "short", "label": "Short" },
        { "value": "long", "label": "Long" }
      ]
    },
    {
      "type": "header",
      "content": "Theme"
    },
    {
      "type": "surface",
      "id": "surface_id",
      "label": "Color Scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "bg_role",
      "label": "Background",
      "default": "body",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "body-alt",
          "label": "Body (alt)"
        },
        {
          "value": "surface",
          "label": "Surface"
        },
        {
          "value": "surface-alt",
          "label": "Surface (alt)"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "button",
          "label": "Button"
        },
        {
          "value": "control",
          "label": "Control"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "palette",
      "id": "bg_role_palette",
      "label": "Background Palette Token",
      "default": "brand",
      "conditional": "setting.bg_role == 'palette'"
    },
    {
      "type": "color",
      "id": "bg_role_custom",
      "label": "Raw Background",
      "conditional": "setting.bg_role == 'custom'"
    },
    {
      "type": "gradient",
      "id": "bg_role_gradient",
      "label": "Background Gradient",
      "conditional": "setting.bg_role == 'gradient'"
    },
    {
      "type": "select",
      "id": "overlay_role",
      "label": "Overlay",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "body-alt",
          "label": "Body (alt)"
        },
        {
          "value": "surface",
          "label": "Surface"
        },
        {
          "value": "surface-alt",
          "label": "Surface (alt)"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "button",
          "label": "Button"
        },
        {
          "value": "control",
          "label": "Control"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "palette",
      "id": "overlay_role_palette",
      "label": "Overlay Palette Token",
      "default": "brand",
      "conditional": "setting.overlay_role == 'palette'"
    },
    {
      "type": "color",
      "id": "overlay_role_custom",
      "label": "Raw Overlay",
      "conditional": "setting.overlay_role == 'custom'"
    },
    {
      "type": "gradient",
      "id": "overlay_role_gradient",
      "label": "Overlay Gradient",
      "conditional": "setting.overlay_role == 'gradient'"
    },
    {
      "type": "range",
      "id": "overlay_alpha",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%",
      "conditional": "setting.overlay_role != 'none' and setting.overlay_role != 'custom'"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "scroll-indicator"
    },
    {
      "type": "text"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_marquee"
    },
    {
      "type": "media"
    },
    {
      "type": "group"
    },
    {
      "type": "button"
    }
  ],
  "presets": [
    {
      "name": "Hero (Fine Dining)",
      "settings": {
        "layout_mode": "overlay",
        "surface_id": "default"
      },
      "blocks": {
        "hero_heading": {
          "type": "text",
          "settings": {
            "content": "Taste the Season",
            "tag": "h1",
            "type_style": "display-1"
          }
        },
        "hero_subtext": {
          "type": "text",
          "settings": {
            "content": "Locally sourced ingredients.",
            "type_style": "body"
          }
        },
        "hero_cta": {
          "type": "button",
          "settings": {
            "label": "Reserve Table",
            "style": "primary"
          }
        }
      },
      "block_order": ["hero_heading", "hero_subtext", "hero_cta"]
    }
  ]
}
{% endschema %}
