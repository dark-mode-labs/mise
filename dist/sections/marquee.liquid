{% assign s = section.settings %}

{%- capture bg_color_value -%}
  {%- render 'role-color-value', kind: 'bg', role: s.bg_role,
      palette: s.bg_role_palette, custom: s.bg_role_custom, gradient: s.bg_role_gradient -%}
{%- endcapture -%}

{% assign bg_class = 'bg-{{ s.bg_role }}' %}
{% if bg_color_value != blank %}{% assign bg_class = '' %}{% endif %}

{%- capture separator_color -%}
  {%- render 'role-color-value', kind: 'bg', role: s.separator_role,
      palette: s.separator_role_palette, custom: s.separator_role_custom -%}
{%- endcapture -%}

{%- capture text_color_value -%}
  {%- render 'role-color-value', kind: 'text', role: s.text_role,
      palette: s.text_role_palette, custom: s.text_role_custom -%}
{%- endcapture -%}
{% assign text_class = 'text-{{ s.text_role }}' %}
{% if text_color_value != blank %}{% assign text_class = '' %}{% endif %}

{% assign container_classes = 'limit-width'
  | push: text_class
  | push: bg_class
  | push: 'width-{{ s.width }}'
  | push: 'pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}'
  | push: 'pl-{{ s.padding_left }} pr-{{ s.padding_right }}'
%}
{%- capture border_class_str -%}{%- render 'box-border-edges', role: s.border_role,
  top: s.border_top, right: s.border_right, bottom: s.border_bottom, left: s.border_left -%}{%- endcapture -%}
{% if border_class_str != blank %}
  {% assign container_classes = container_classes | push: border_class_str %}
{% endif %}

{% assign container_class_str = container_classes | join: ' ' %}

{% assign styles = blank %}
{% if bg_color_value != blank %}
  {% assign styles = styles | push: 'background: {{ bg_color_value }}' %}
{% endif %}
{% if text_color_value != blank %}
  {% assign styles = styles | push: 'color: {{ text_color_value }}' %}
{% endif %}
{% if border_class_str != blank %}
  {%- capture border_style_str -%}{%- render 'box-border-style',
    role: s.border_role, palette_token: s.border_role_palette,
    gradient_token: s.border_role_gradient, custom_color: s.border_role_custom,
    style: s.border_style -%}{%- endcapture -%}
  {% assign styles = styles | push: border_style_str %}
{% endif %}
{% assign style_str = styles | join: ';' %}

{% assign margin_styles = blank %}
{% assign margin_style_str = margin_styles | join: ';' %}

{% assign mq_size_class = 'text-size-{{ s.text_size }}' %}
{% assign mq_uppercase = s.uppercase %}
{% assign mq_item_style = blank %}
{% if s.type_style != blank %}
  {% assign mq_size_class = 'ts-{{ s.type_style }}' %}
  {% assign mq_uppercase = false %}
{% endif %}

<section
  class='section-marquee surface-{{ s.surface_id }} mt-{{ s.margin_top }} mb-{{ s.margin_bottom }} ml-{{ s.margin_left }} mr-{{ s.margin_right }}'
  style='{{ margin_style_str }}'
  {{ context.attached_attributes }}
>
  <div
    class='{{ container_class_str }}'
    style='{{ style_str }}'
  >
    {% render 'marquee',
      items: s.text_list,
      speed: s.speed,
      item_gap: s.item_gap,
      direction: s.direction,
      size_class: mq_size_class,
      item_style: mq_item_style,
      uppercase: mq_uppercase,
      separator: s.separator,
      separator_color: separator_color
    %}
  </div>
</section>
{% schema %}
{
  "name": "Scrolling Text",
  "settings": [
    {
      "type": "header",
