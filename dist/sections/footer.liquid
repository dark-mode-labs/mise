{% assign s = section.settings %}

{%- capture bg_color_value -%}
  {%- render 'role-color-value', kind: 'bg', role: s.bg_role,
      palette: s.bg_role_palette, custom: s.bg_role_custom, gradient: s.bg_role_gradient -%}
{%- endcapture -%}

{%- capture border_color_value -%}
  {%- render 'role-color-value', kind: 'border', role: s.border_role,
      palette: s.border_role_palette, custom: s.border_role_custom, gradient: s.border_role_gradient -%}
{%- endcapture -%}

{% assign border_classes = '' %}
{% unless s.border_mode == 'none' %}
  {% assign border_classes = border_classes
    | push: 'group-border-{{ s.border_mode }}'
    | push: 'group-border-size-{{ s.border_size }}'
  %}
  {% if s.border_role
    and s.border_role != 'none'
    and s.border_role != 'custom'
    and s.border_role != 'palette'
    and s.border_role != 'gradient'
  %}
    {% assign border_classes = border_classes | push: 'border-{{ s.border_role }}' %}
  {% endif %}
  {% if s.border_role == 'gradient' %}
    {% assign border_classes = border_classes | push: 'border-gradient' %}
  {% endif %}
  {% if s.border_mode == 'custom' %}
    {% assign border_classes = border_classes
      | push_if: 'group-border-custom-left', s.border_custom_left
      | push_if: 'group-border-custom-right', s.border_custom_right
      | push_if: 'group-border-custom-top', s.border_custom_top
      | push_if: 'group-border-custom-bottom', s.border_custom_bottom
    %}
  {% endif %}
{% endunless %}
{% assign border_class_str = border_classes | join: ' ' %}

{% assign container_classes = 'width-{{ s.width }} limit-width'
  | push: 'pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}'
  | push: 'pl-{{ s.padding_left }} pr-{{ s.padding_right }}'
%}

{% assign container_class_str = container_classes | join: ' ' %}

{% assign spacing_styles = blank %}

{% assign spacing_style_str = spacing_styles | join: ';' %}

{% assign bg_class = 'bg-{{ s.bg_role }}' %}
{% if bg_color_value != blank %}{% assign bg_class = '' %}{% endif %}

{% assign bg_layer_style = blank %}
{% if bg_color_value != blank %}
  {% assign bg_layer_style = bg_layer_style | push: 'background: {{ bg_color_value }}' %}
{% endif %}
{% unless s.border_mode == 'none' %}
  {% assign bg_layer_style = bg_layer_style | push: '--border-style: {{ s.border_style }}' %}
  {% if s.border_size == 'custom' %}
    {% assign bg_layer_style = bg_layer_style | push: '--border-width: {{ s.border_size_custom }}px' %}
  {% endif %}
  {% if border_color_value != blank %}
    {% assign bg_layer_style = bg_layer_style | push: '--border: {{ border_color_value }}' %}
  {% endif %}
{% endunless %}
{% assign bg_layer_style_str = bg_layer_style | join: ';' %}

{% assign styles = blank %}
{% assign style_str = styles | join: ';' %}

<footer
  class='section-footer surface-{{ s.surface_id }} text-primary relative isolate mt-{{ s.margin_top }} mb-{{ s.margin_bottom }} ml-{{ s.margin_left }} mr-{{ s.margin_right }}'
  style='{{ style_str }}'
  {{ context.attached_attributes }}
>
  <div
    class='footer-bg-layer relative width-{{ s.width_bg }} limit-width {{ bg_class }} {{ border_class_str }}'
    style='{{ bg_layer_style_str }}'
  >
    {% render 'bg-overlay',
      role: s.overlay_role,
      alpha: s.overlay_alpha,
      palette_token: s.overlay_role_palette,
      custom_color: s.overlay_role_custom,
      gradient_token: s.overlay_role_gradient,
      behind: true
    %}
    <div
      class='{{ container_class_str }} relative'
      style='{{ spacing_style_str }}'
    >
      <div class='flex flex-auto flex-col justify-content-{{ s.content_align }}'>
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</footer>
