{%- comment -%}
  box-border-class — the `group-border-*` classes a border mode asks for; `box-border-style` is
  the value half and a caller needs both. Shared by the box-owning sections and `group`; the other
  components still spell it inline.

  Emits NOTHING when mode is 'none'. Inputs:
    mode         — border_mode: 'none' | 'full' | 'custom'
    role         — border_role. A SLOT role emits `border-<role>`, which reads that slot's
                   variable; 'palette' / 'custom' resolve to a value the style half writes, and
                   'gradient' needs `border-gradient` because border-color cannot take one.
    size_tier    — border_size tier id.
    custom_left / custom_right / custom_top / custom_bottom
                 — which edges draw, honoured only when mode is 'custom'
{%- endcomment -%}
{%- unless mode == 'none' -%}
  {%- assign classes = blank -%}
  {%- assign classes = classes | push: 'group-border-{{ mode }}' | push: 'group-border-size-{{ size_tier }}' -%}
  {%- if role and role != 'none' and role != 'custom' and role != 'palette' and role != 'gradient' -%}
    {%- assign classes = classes | push: 'border-{{ role }}' -%}
  {%- endif -%}
  {%- if role == 'gradient' -%}
    {%- assign classes = classes | push: 'border-gradient' -%}
  {%- endif -%}
  {%- if mode == 'custom' -%}
    {%- assign classes = classes
      | push_if: 'group-border-custom-left', custom_left
      | push_if: 'group-border-custom-right', custom_right
      | push_if: 'group-border-custom-top', custom_top
      | push_if: 'group-border-custom-bottom', custom_bottom
    -%}
  {%- endif -%}
  {{- classes | join: ' ' -}}
{%- endunless -%}
