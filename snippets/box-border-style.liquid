{%- comment -%}
  box-border-style — the custom properties a border mode asks for, semicolon-joined. The value half
  of `box-border-class`; a caller needs both, and appends this to the same element's own style list.

  Emits NOTHING when mode is 'none'. Inputs:
    mode           — border_mode: 'none' | 'full' | 'custom'
    role           — border_role; only 'palette' / 'gradient' / 'custom' resolve to a value here,
                     because a slot role reaches the element as a class instead.
    palette_token  — border_role_palette token name
    gradient_token — border_role_gradient token name
    custom_color   — border_role_custom raw value
    style          — border_style
    size           — border_size tier id; 'custom' takes its width from `size_custom`
    size_custom    — px width, honoured only when size is 'custom'
{%- endcomment -%}
{%- unless mode == 'none' -%}
  {%- assign decls = '--border-style: {{ style }}' -%}
  {%- if size == 'custom' -%}
    {%- assign decls = decls | push: '--border-width: {{ size_custom }}px' -%}
  {%- endif -%}
  {%- if role == 'palette' and palette_token != blank -%}
    {%- assign decls = decls | push: '--border: var(--palette-{{ palette_token }})' -%}
  {%- elsif role == 'gradient' and gradient_token != blank -%}
    {%- assign decls = decls | push: '--border: var(--gradient-{{ gradient_token }})' -%}
  {%- elsif role == 'custom' and custom_color != blank -%}
    {%- assign decls = decls | push: '--border: {{ custom_color }}' -%}
  {%- endif -%}
  {{- decls | join: ';' -}}
{%- endunless -%}
