{% assign s = block.settings %}

{% assign nav_classes = 'header-nav'
  | push: 'pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}'
  | push: 'pl-{{ s.padding_left }} pr-{{ s.padding_right }}'
%}
{% unless s.border_mode == 'none' or s.border_mode == blank %}
  {% assign nav_classes = nav_classes
    | push: 'group-border-{{ s.border_mode }}'
    | push: 'group-border-size-{{ s.border_size }}'
  %}
  {% if s.border_role != blank
    and s.border_role != 'none'
    and s.border_role != 'custom'
    and s.border_role != 'palette'
  %}
    {% assign nav_classes = nav_classes | push: 'border-{{ s.border_role }}' %}
  {% endif %}
  {% if s.border_mode == 'custom' %}
    {% assign nav_classes = nav_classes
      | push_if: 'group-border-custom-left', s.border_custom_left
      | push_if: 'group-border-custom-right', s.border_custom_right
      | push_if: 'group-border-custom-top', s.border_custom_top
      | push_if: 'group-border-custom-bottom', s.border_custom_bottom
    %}
  {% endif %}
{% endunless %}

{% if s.surface_override %}
  {% assign nav_classes = nav_classes | push: "surface-{{ s.surface_id | default: 'default' }}" %}
{% endif %}

{% assign block_classes = nav_classes | join: ' ' %}

{% assign text_color_value = blank %}
{% if s.text_role == 'palette' and s.text_role_palette != blank %}
  {% assign text_color_value = 'var(--palette-{{ s.text_role_palette }})' %}
{% elsif s.text_role == 'custom' and s.text_role_custom != blank %}
  {% assign text_color_value = s.text_role_custom %}
{% elsif s.text_role != blank and s.text_role != 'inherit' and s.text_role != 'primary' %}
  {% assign text_color_value = 'var(--text-{{ s.text_role }})' %}
{% endif %}
{% assign styles = blank %}
{% if text_color_value != blank %}
  {% assign styles = styles | push: '--text: {{ text_color_value }}' %}
{% endif %}
{% assign border_color_value = blank %}
{% if s.border_role == 'palette' and s.border_role_palette != blank %}
  {% assign border_color_value = 'var(--palette-{{ s.border_role_palette }})' %}
{% elsif s.border_role == 'custom' and s.border_role_custom != blank %}
  {% assign border_color_value = s.border_role_custom %}
{% endif %}
{% unless s.border_mode == 'none' or s.border_mode == blank %}
  {% assign styles = styles | push: '--border-style: {{ s.border_style }}' %}
  {% if s.border_size == 'custom' %}
    {% assign styles = styles | push: '--border-width: {{ s.border_size_custom }}px' %}
  {% endif %}
  {% if border_color_value != blank %}
    {% assign styles = styles | push: '--border: {{ border_color_value }}' %}
  {% endif %}
{% endunless %}
{% assign block_styles = styles | join: ';' %}

{% assign color_role = s.text_role %}
{% if s.text_role == 'custom' or s.text_role == 'palette' %}
  {% assign color_role = 'primary' %}
{% endif %}

{% assign utilities = blank %}

{% case s.text_wrap %}
  {% when 'nowrap' %}
    {% assign utilities = utilities | push: 'whitespace-nowrap' %}
  {% when 'balance' %}
    {% assign utilities = utilities | push: 'text-balance' %}
{% endcase %}

{% assign utility_classes = utilities | join: ' ' %}

{% assign link_classes = 'flex'
  | push: 'items-center'
  | push: 'gap-{{ s.link_icon_gap }}'
  | push: 'pt-{{ s.link_padding_top }} pb-{{ s.link_padding_bottom }}'
  | push: 'pl-{{ s.link_padding_left }} pr-{{ s.link_padding_right }}'
%}
{% for ef_id in s.link_effect %}
  {% assign link_classes = link_classes | push: 'ef-{{ ef_id }}' %}
{% endfor %}
{% if s.link_border_role != blank and s.link_border_role != 'none' %}
  {% assign link_classes = link_classes
    | push: 'group-border-custom-bottom group-border-size-{{ s.link_border_size }}'
  %}
  {% if s.link_border_role != 'custom' and s.link_border_role != 'palette' %}
    {% assign link_classes = link_classes | push: 'border-{{ s.link_border_role }}' %}
  {% endif %}
{% endif %}
{% assign link_class_str = link_classes | join: ' ' %}

{% assign link_border_value = blank %}
{% if s.link_border_role == 'palette' and s.link_border_role_palette != blank %}
  {% assign link_border_value = 'var(--palette-{{ s.link_border_role_palette }})' %}
{% elsif s.link_border_role == 'custom' and s.link_border_role_custom != blank %}
  {% assign link_border_value = s.link_border_role_custom %}
{% endif %}
{% assign link_styles = blank %}
{% if link_border_value != blank %}
  {% assign link_styles = link_styles | push: '--border-style:solid' | push: '--border: {{ link_border_value }}' %}
{% endif %}
{% assign link_style_str = link_styles | join: ';' %}

{% assign list_classes = 'flex direction-row' | push: 'vertical-{{ s.link_align }}' | push: 'gap-{{ s.gap }}' %}
{% assign list_class_str = list_classes | join: ' ' %}

{% assign last_link = s.nav.links | size | minus: 1 %}

<nav
  class='{{ block_classes }}'
  style='{{ block_styles }}'
  {{ context.attached_attributes }}
>
  <ul class='{{ list_class_str }}'>
    {% for link in s.nav.links %}
      {% assign has_mega = false %}
      {% if link.levels > 1 %}{% assign has_mega = true %}{% endif %}

      {% assign this_link_class = link_class_str %}
      {% if forloop.index0 == last_link %}
        {% assign this_link_class = link_class_str | replace: 'group-border-custom-bottom', '' %}
      {% endif %}
      <li class='group flex items-center relative'>
        <a
          href='{{ link.url }}'
          class='{{ this_link_class }}'
          style='{{ link_style_str }}'
        >
          {% render 'typography',
            text: link.title,
            type_style: s.type_style,
            color_role: color_role,
            class: utility_classes
          %}
          {% if link.links != blank %}
            {% render 'icon',
              name: 'chevron-down',
              class: 'w-3 h-3 opacity-50 group-hover:rotate-180 transition-transform'
            %}
          {% endif %}
        </a>

        {% if link.links != blank %}
          <div
            class='
              absolute top-full left-0 border border-default shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-floating
              {% if has_mega %}!fixed left-0 right-0 w-full border-x-0{% else %}w-64{% endif %}
            '
          >
            {% if has_mega %}
              <div class='mx-auto px-8 py-12 grid grid-cols-4 gap-8'>
                {% for child in link.links %}
                  <div>
                    <a
                      href='{{ child.url }}'
                      class='block mb-4 hover:underline underline-offset-4'
                    >
                      {% render 'typography',
                        type_style: s.type_style,
                        text: child.title,
                        color_role: color_role,
                        class: utility_classes
                      %}
                    </a>
                    <ul class='flex flex-col gap-xs'>
                      {% for grandchild in child.links %}
                        <li>
                          <a
                            href='{{ grandchild.url }}'
                            class='opacity-70 hover:opacity-100 block'
                          >
                            {% render 'typography',
                              type_style: s.type_style,
                              text: grandchild.title,
                              color_role: color_role,
                              class: utility_classes
                            %}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endfor %}
              </div>

            {% else %}
              <ul class='py-4'>
                {% for child in link.links %}
                  <li>
                    <a href='{{ child.url }}' class='ts-body-sm block px-6 py-2 hover:bg-gray-50/5 whitespace-nowrap'>
                      {{ child.title }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>

{% schema %}
{
  "name": "Header Nav",
  "settings": [
    {
      "type": "link_list",
      "id": "nav",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "space",
      "id": "padding_top",
      "label": "Padding Top",
      "default": "none"
    },
    {
      "type": "space",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": "none"
    },
    {
      "type": "space",
      "id": "padding_left",
      "label": "Padding Left",
      "default": "none"
    },
    {
      "type": "space",
      "id": "padding_right",
      "label": "Padding Right",
      "default": "none"
    },
    {
      "type": "select",
      "id": "border_mode",
      "label": "Border",
      "default": "none",
      "options": [
        {
          "value": "custom",
          "label": "Custom"
        },
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "select",
      "id": "border_role",
      "label": "Border Color",
      "default": "default",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "emphasis",
          "label": "Emphasis"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "conditional": "setting.border_mode != 'none'"
    },
    {
      "type": "palette",
      "id": "border_role_palette",
      "label": "Border Palette Token",
      "default": "brand",
      "conditional": "setting.border_role == 'palette' and setting.border_mode != 'none'"
    },
    {
      "type": "color",
      "id": "border_role_custom",
      "label": "Raw Border",
      "conditional": "setting.border_role == 'custom' and setting.border_mode != 'none'"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Border Style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "border_custom_left",
      "label": "Border Left",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_right",
      "label": "Border Right",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_top",
      "label": "Border Top",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "checkbox",
      "id": "border_custom_bottom",
      "label": "Border Bottom",
      "default": false,
      "conditional": "setting.border_mode == 'custom'"
    },
    {
      "type": "select",
      "id": "border_size",
      "label": "Border Size",
      "options": [
        {
          "value": "xxs",
          "label": "XXS",
          "info": "1px"
        },
        {
          "value": "xs",
          "label": "XS",
          "info": "2px"
        },
        {
          "value": "sm",
          "label": "Small",
          "info": "4px"
        },
        {
          "value": "md",
          "label": "Medium",
          "info": "6px"
        },
        {
          "value": "lg",
          "label": "Large",
          "info": "8px"
        },
        {
          "value": "custom",
          "label": "Custom",
          "info": "Exact px width"
        }
      ],
      "default": "md",
      "conditional": "setting.border_mode != 'none'"
    },
    {
      "type": "range",
      "id": "border_size_custom",
      "label": "Custom Border Width",
      "min": 0,
      "max": 12,
      "step": 0.5,
      "default": 1,
      "unit": "px",
      "conditional": "setting.border_size == 'custom'"
    },
    {
      "type": "select",
      "id": "link_align",
      "label": "Link Vertical Align",
      "info": "Cross-axis alignment of each link and of the strip.",
      "default": "middle",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "baseline",
          "label": "Baseline"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "space",
      "id": "link_icon_gap",
      "label": "Link Icon Gap",
      "info": "Between a link's label and its submenu chevron.",
      "default": "xxs"
    },
    {
      "type": "select",
      "subtype": "border_role",
      "id": "link_border_role",
      "label": "Link Divider",
      "default": "none",
      "info": "A rule under every link but the last."
    },
    {
      "type": "palette",
      "id": "link_border_role_palette",
      "label": "Link Divider Token",
      "conditional": "setting.link_border_role == 'palette'"
    },
    {
      "type": "color",
      "id": "link_border_role_custom",
      "label": "Link Divider Color",
      "conditional": "setting.link_border_role == 'custom'"
    },
    {
      "type": "select",
      "subtype": "border_size",
      "id": "link_border_size",
      "label": "Link Divider Width",
      "default": "xxs"
    },
    {
      "type": "space",
      "id": "link_padding_top",
      "label": "Link Padding Top",
      "default": "none"
    },
    {
      "type": "space",
      "id": "link_padding_bottom",
      "label": "Link Padding Bottom",
      "default": "none"
    },
    {
      "type": "space",
      "id": "link_padding_left",
      "label": "Link Padding Left",
      "default": "none"
    },
    {
      "type": "space",
      "id": "link_padding_right",
      "label": "Link Padding Right",
      "default": "none"
    },
    {
      "type": "space",
      "id": "gap",
      "label": "Gap",
      "default": "xs"
    },
    {
      "type": "effect",
      "id": "link_effect",
      "label": "Link Effects",
      "default": [],
      "info": "Effects applied to each nav link; several compose."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "type_style",
      "id": "type_style",
      "label": "Type Style",
      "default": "nav"
    },
    {
      "type": "select",
      "id": "text_wrap",
      "label": "Text Wrapping",
      "default": "nowrap",
      "options": [
        {
          "value": "wrap",
          "label": "Wrap"
        },
        {
          "value": "nowrap",
          "label": "No Wrap"
        },
        {
          "value": "balance",
          "label": "Balance"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_role",
      "label": "Text Color Role",
      "info": "Defaults to inheriting the header section's text role.",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit from Header"
        },
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "emphasis",
          "label": "Emphasis"
        },
        {
          "value": "on-accent",
          "label": "On Accent"
        },
        {
          "value": "on-button",
          "label": "On Button"
        },
        {
          "value": "on-control",
          "label": "On Control"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        }
      ]
    },
    {
      "type": "palette",
      "id": "text_role_palette",
      "label": "Text Palette Token",
      "default": "brand",
      "conditional": "setting.text_role == 'palette'"
    },
    {
      "type": "color",
      "id": "text_role_custom",
      "label": "Raw Text Color",
      "conditional": "setting.text_role == 'custom'"
    },
    {
      "type": "header",
      "content": "General Style"
    },
    {
      "type": "header",
      "content": "Overrides",
      "conditional": "true"
    },
    {
      "type": "checkbox",
      "id": "surface_override",
      "label": "Override Color Scheme",
      "default": false,
      "conditional": "true"
    },
    {
      "type": "surface",
      "id": "surface_id",
      "label": "Color Scheme",
      "default": "default",
      "conditional": "setting.surface_override == true"
    }
  ]
}
{% endschema %}
