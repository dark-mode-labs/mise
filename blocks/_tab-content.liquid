{% assign s = block.settings %}

{%- capture active_border_value -%}
  {%- render 'role-color-value', kind: 'border', role: s.active_border_role,
      palette: s.active_border_role_palette, custom: s.active_border_role_custom -%}
{%- endcapture -%}

{%- capture resting_border_value -%}
  {%- render 'role-color-value', kind: 'border', role: s.border_role,
      palette: s.border_role_palette, custom: s.border_role_custom -%}
{%- endcapture -%}

{% assign active_state_classes = '' %}
{% assign active_state_styles = '' %}
{% assign resting_styles = '' %}

{% if resting_border_value != blank %}
  {% assign resting_styles = resting_styles | push: '--border:{{ resting_border_value }}' %}
{% endif %}

{% if active_border_value != blank %}
  {% assign active_state_styles = active_state_styles | push: '--border:{{ active_border_value }}' %}
{% endif %}

{% for ef_id in s.active_effect %}
  {% assign active_state_classes = active_state_classes | push: 'ef-{{ ef_id }}' %}
{% endfor %}

{% assign tab_group = s.tab_group %}
{% if tab_group == blank %}{% assign tab_group = section.id %}{% endif %}

<div
  {{ context.attached_attributes }}
  class='tab-content'
  data-behavior='tab-content'
  data-tab-id='{{ s.tab_id }}'
  data-tab-group='{{ tab_group }}'
  data-tab-active-class='{{ active_state_classes | join: ' ' }}'
  data-tab-active-styles='{{ active_state_styles | join: ';' }}'
  {% if resting_styles != blank %}
    style='{{ resting_styles | join: ';' }}'
  {% endif %}
  aria-expanded='{% if s.default_tab_id != blank and s.tab_id == s.default_tab_id %}true{% else %}false{% endif %}'
>
  {% content_for 'blocks' %}
</div>
{% schema %}
{
  "name": "Tab Content",
  "settings": [
    {
      "type": "type_style",
      "id": "type_style",
      "label": "Type Style",
      "default": "body"
    },
    {
      "type": "header",
      "content": "Binding"
    },
    {
      "type": "text",
      "id": "tab_id",
      "label": "Tab Identifier",
      "default": "{{ context.item.uuid }}"
    },
    {
      "type": "text",
      "id": "tab_group",
      "label": "Tab Group"
    },
    {
      "type": "text",
      "id": "default_tab_id",
      "label": "Default Tab Identifier",
      "info": "The pane that starts selected when no tab head decides; blank means the first."
    },
    {
      "type": "data_source",
      "id": "bind_to",
      "label": "Bind to"
    },
    {
      "type": "header",
      "content": "Selected"
    },
    {
      "type": "select",
      "id": "border_role",
      "label": "Resting Border",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "palette", "label": "Base Palette" },
        { "value": "custom", "label": "Raw Color" }
      ],
      "info": "Border colour of descendants deferring to a surface slot, while this pane is NOT selected. The pane owns both states because a descendant that declares the colour itself cancels the selected rebinding."
    },
    {
      "type": "palette",
      "id": "border_role_palette",
      "label": "Resting Border Palette Token",
      "default": "brand",
      "conditional": "setting.border_role == 'palette'"
    },
    {
      "type": "color",
      "id": "border_role_custom",
      "label": "Resting Border Raw Color",
      "conditional": "setting.border_role == 'custom'"
    },
    {
      "type": "select",
      "subtype": "border_role",
      "id": "active_border_role",
      "label": "Selected Border",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        }
      ],
      "info": "Border colour of descendants deferring to a surface slot, while this pane is selected. A slot role would resolve to the variable this rebinds, so there is none."
    },
    {
      "type": "palette",
      "id": "active_border_role_palette",
      "label": "Selected Border Palette Token",
      "default": "brand",
      "conditional": "setting.active_border_role == 'palette'"
    },
    {
      "type": "color",
      "id": "active_border_role_custom",
      "label": "Selected Border Raw Color",
      "conditional": "setting.active_border_role == 'custom'"
    },
    {
      "type": "effect",
      "id": "active_effect",
      "label": "Selected Effect"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ]
}
{% endschema %}
