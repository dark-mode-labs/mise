{% assign s = block.settings %}

{% comment %} --- Wrapper Classes --- {% endcomment %}
{% assign classes = 'icon icon-size inline-flex items-center justify-center flex-shrink-0'
  | push: 'mt-{{ s.margin_top }} mb-{{ s.margin_bottom }}'
  | push: 'ml-{{ s.margin_left }} mr-{{ s.margin_right }}'
  | push: 'pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}'
  | push: 'pl-{{ s.padding_left }} pr-{{ s.padding_right }}'
%}
{% if s.align_self != blank and s.align_self != 'auto' -%}
  {%- assign classes = classes | push: 'self-{{ s.align_self }}' -%}
{%- endif %}

{%- capture color_class -%}{%- render 'text-color-class', color_role: s.text_role -%}{%- endcapture -%}
{% if color_class == blank and s.text_role != 'inherit' and s.text_role != 'none' %}
  {% assign color_class = 'text-primary' %}
{% endif %}
{% assign classes = classes | push_if: "surface-{{ s.surface_id | default: 'default' }}", s.surface_override %}
{% assign block_classes = classes | push: color_class | join: ' ' %}

{% comment %} --- Styles Array Building --- {% endcomment %}
{% assign text_color_value = blank %}
{% if s.text_role == 'palette' and s.text_role_palette != blank %}
  {% assign text_color_value = 'var(--palette-{{ s.text_role_palette }})' %}
{% elsif s.text_role == 'custom' and s.text_role_custom != blank %}
  {% assign text_color_value = s.text_role_custom %}
{% endif %}
{% assign styles = blank %}

{% assign styles = styles | push: '--icon-size: {{ s.icon_size }}rem' %}

{% if text_color_value != blank %}
  {% assign styles = styles | push: '--text: {{ text_color_value }}' %}
{% endif %}
{% assign block_styles = styles | join: ';' %}

{% comment %} --- Component Render --- {% endcomment %}
<div
  class='{{ block_classes }}'
  style='{{ block_styles }}'
  {{ context.attached_attributes }}
>
  {{ s.svg }}
</div>
{% schema %}
{
  "name": "Icon",
  "settings": [
    {
      "type": "select",
      "id": "align_self",
      "label": "Align Self",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "start",
          "label": "Top / Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom / End"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "textarea",
      "id": "svg",
      "label": "SVG",
      "default": "<svg fill=\"currentColor\" stroke=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clip-rule=\"evenodd\"/></svg>"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 0.75,
      "max": 8,
      "step": 0.25,
      "default": 1.5,
      "unit": "rem"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "space",
      "id": "padding_top",
      "label": "Padding Top",
      "default": "none"
    },
    {
      "type": "space",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": "none"
    },
    {
      "type": "space",
      "id": "padding_left",
      "label": "Padding Left",
      "default": "none"
    },
    {
      "type": "space",
      "id": "padding_right",
      "label": "Padding Right",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_top",
      "label": "Margin Top",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_left",
      "label": "Margin Left",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_right",
      "label": "Margin Right",
      "default": "none"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "text_role",
      "label": "Text Color Role",
      "default": "primary",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit"
        },
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "emphasis",
          "label": "Emphasis"
        },
        {
          "value": "on-accent",
          "label": "On Accent"
        },
        {
          "value": "on-button",
          "label": "On Button"
        },
        {
          "value": "on-control",
          "label": "On Control"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        }
      ]
    },
    {
      "type": "palette",
      "id": "text_role_palette",
      "label": "Text Palette Token",
      "default": "brand",
      "conditional": "setting.text_role == 'palette'"
    },
    {
      "type": "color",
      "id": "text_role_custom",
      "label": "Raw Text Color",
      "conditional": "setting.text_role == 'custom'"
    },
    {
      "type": "header",
      "content": "Overrides",
      "conditional": "true"
    },
    {
      "type": "checkbox",
      "id": "surface_override",
      "label": "Override Color Scheme",
      "default": false,
      "conditional": "true"
    },
    {
      "type": "surface",
      "id": "surface_id",
      "label": "Color Scheme",
      "default": "default",
      "conditional": "setting.surface_override == true"
    }
  ]
}
{% endschema %}
