  "presets": [
    {
      "name": "full-menu-card",
      "blocks": {
        "menu-card-header": {
          "type": "group",
          "name": "Heading",
          "static": true,
          "settings": {
            "gap": "none",
            "padding_top": "none",
            "padding_bottom": "none",
            "padding_left": "none",
            "padding_right": "none"
          },
          "blocks": {
            "img": {
              "type": "media",
              "settings": {
                "image": "{{ context.item.asset.url }}",
                "object_fit": "cover",
                "aspect_ratio": "landscape"
              }
            }
          },
          "block_order": ["img"]
        },
        "menu-card-content": {
          "type": "group",
          "name": "Content",
          "static": true,
          "settings": {
            "gap": "sm",
            "padding_top": "xs",
            "padding_bottom": "xs",
            "padding_left": "md",
            "padding_right": "md",
            "grow_content": true
          },
          "blocks": {
            "desc": {
              "type": "text",
              "settings": {
                "content": "{{ context.item.description }}",
                "text_align": "left",
                "type_style": "caption"
              }
            },
            "info": {
              "type": "group",
              "blocks": {
                "price": {
                  "type": "text",
                  "settings": {
                    "tag": "span",
                    "content": "{{ context.item.formatted_price }}",
                    "text_align": "right",
                    "type_style": "body"
                  }
                },
                "title": {
                  "type": "text",
                  "settings": {
                    "tag": "h3",
                    "content": "{{ context.item.name }}",
                    "text_wrap": "balance",
                    "text_align": "left",
                    "type_style": "body"
                  }
                }
              },
              "settings": {
                "gap": "xs",
                "width": "full",
                "direction": "row",
                "content_align": "between",
                "vertical_align": "top",
                "padding_top": "xs",
                "padding_bottom": "xs",
                "padding_left": "none",
                "padding_right": "none"
              },
              "block_order": ["title", "price"]
            }
          },
          "block_order": ["info", "desc"]
        },
        "menu-card-footer": {
          "type": "group",
          "name": "Footer",
          "static": true,
          "settings": {
            "gap": "xs",
            "padding_top": "xs",
            "padding_bottom": "xs",
            "padding_left": "md",
            "padding_right": "md"
          },
          "blocks": {
            "btn": {
              "type": "button",
              "settings": {
                "label": "Order Now",
                "width": "full",
                "content_align": "center",
                "trigger": "action",
                "action": "add-item"
              }
            }
          },
          "block_order": ["btn"]
        }
      },
      "settings": {
        "gap": "none",
        "shadow": true
      }
    }
  ]
}
{% endschema %}
