{% assign s = section.settings %}

{% assign bg_color_value = blank %}
{% if s.bg_role == 'palette' and s.bg_role_palette != blank %}
  {% assign bg_color_value = 'var(--palette-{{ s.bg_role_palette }})' %}
{% elsif s.bg_role == 'gradient' and s.bg_role_gradient != blank %}
  {% assign bg_color_value = 'var(--gradient-{{ s.bg_role_gradient }})' %}
{% elsif s.bg_role == 'custom' and s.bg_role_custom != blank %}
  {% assign bg_color_value = s.bg_role_custom %}
{% endif %}

{% assign surface_safe = s.surface_id | default: 'default' %}
{% assign bg_role_safe = s.bg_role | default: 'none' %}
{% assign bg_class = '' %}
{% if bg_color_value == blank and bg_role_safe != 'none' %}
  {% assign bg_class = 'bg-' | append: bg_role_safe %}
{% endif %}

{% assign margin_styles = blank %}
{% if s.margin_vertical == 'custom' %}
  {% assign margin_styles = margin_styles
    | push: '--space-mt: {{ s.margin_vertical_custom_top }}rem'
    | push: '--space-mb: {{ s.margin_vertical_custom_bottom }}rem'
  %}
{% endif %}
{% if s.margin_horizontal == 'custom' %}
  {% assign margin_styles = margin_styles
    | push: '--space-ml: {{ s.margin_horizontal_custom_left }}rem'
    | push: '--space-mr: {{ s.margin_horizontal_custom_right }}rem'
  %}
{% endif %}

{% assign bg_layer_styles = blank %}
{% if bg_color_value != blank %}
  {% assign bg_layer_styles = bg_layer_styles | push: 'background: {{ bg_color_value }}' %}
{% endif %}
{% if s.padding_vertical == 'custom' %}
  {% assign bg_layer_styles = bg_layer_styles
    | push: '--space-pt: {{ s.padding_vertical_custom_top }}rem'
    | push: '--space-pb: {{ s.padding_vertical_custom_bottom }}rem'
  %}
{% endif %}
{% if s.padding_horizontal == 'custom' %}
  {% assign bg_layer_styles = bg_layer_styles
    | push: '--space-pl: {{ s.padding_horizontal_custom_left }}rem'
    | push: '--space-pr: {{ s.padding_horizontal_custom_right }}rem'
  %}
{% endif %}

<section
  class='tabs-section surface-{{ surface_safe }} relative isolate margin-my-{{ s.margin_vertical }} margin-mx-{{ s.margin_horizontal }}'
  style='{{ margin_styles | join: ';' }}'
  {{ context.attached_attributes }}
>
  <div
    class='tabs-bg-layer relative limit-width width-{{ s.width_bg }} {{ bg_class }} padding-py-{{ s.padding_vertical }} padding-px-{{ s.padding_horizontal }}'
    style='{{ bg_layer_styles | join: ';' }}'
  >
    {% content_for 'blocks' %}
  </div>
</section>

{% schema %}
{
  "name": "Tabs",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "width", "id": "width_bg", "label": "Background Width", "default": "fill" },
    { "type": "space", "id": "padding_vertical", "label": "Vertical Padding", "default": "sm" },
    {
      "type": "range",
      "id": "padding_vertical_custom_top",
      "label": "Custom Top Padding",
      "min": 0,
      "max": 8,
      "step": 0.25,
      "default": 0,
      "unit": "rem",
      "conditional": "setting.padding_vertical == 'custom'"
    },
    {
      "type": "range",
      "id": "padding_vertical_custom_bottom",
      "label": "Custom Bottom Padding",
      "min": 0,
      "max": 8,
      "step": 0.25,
      "default": 0,
      "unit": "rem",
      "conditional": "setting.padding_vertical == 'custom'"
    },
    { "type": "space", "id": "padding_horizontal", "label": "Horizontal Padding", "default": "sm" },
    { "type": "space", "id": "margin_vertical", "label": "Vertical Margin", "default": "none" },
    {
      "type": "range",
      "id": "margin_vertical_custom_top",
      "label": "Custom Top Margin",
      "min": -8,
      "max": 8,
      "step": 0.25,
      "default": 0,
      "unit": "rem",
      "conditional": "setting.margin_vertical == 'custom'"
    },
    {
      "type": "range",
      "id": "margin_vertical_custom_bottom",
      "label": "Custom Bottom Margin",
      "min": -8,
      "max": 8,
      "step": 0.25,
      "default": 0,
      "unit": "rem",
      "conditional": "setting.margin_vertical == 'custom'"
    },
    { "type": "space", "id": "margin_horizontal", "label": "Horizontal Margin", "default": "none" },
    {
      "type": "range",
      "id": "margin_horizontal_custom_left",
      "label": "Custom Left Margin",
      "min": -8,
      "max": 8,
      "step": 0.25,
      "default": 0,
      "unit": "rem",
      "conditional": "setting.margin_horizontal == 'custom'"
    },
    {
      "type": "range",
      "id": "margin_horizontal_custom_right",
      "label": "Custom Right Margin",
      "min": -8,
      "max": 8,
      "step": 0.25,
      "default": 0,
      "unit": "rem",
      "conditional": "setting.margin_horizontal == 'custom'"
    },
    { "type": "header", "content": "Theme" },
    { "type": "surface", "id": "surface_id", "label": "Color Scheme", "default": "default" },
    {
      "type": "select",
      "id": "bg_role",
      "label": "Background",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "body", "label": "Body" },
        { "value": "body-alt", "label": "Body (alt)" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface (alt)" },
        { "value": "accent", "label": "Accent" },
        { "value": "button", "label": "Button" },
        { "value": "control", "label": "Control" },
        { "value": "palette", "label": "Base Palette" },
        { "value": "custom", "label": "Raw Color" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "palette",
      "id": "bg_role_palette",
      "label": "Background Palette Token",
      "default": "brand",
      "conditional": "setting.bg_role == 'palette'"
    },
    {
      "type": "color",
      "id": "bg_role_custom",
      "label": "Raw Background",
      "conditional": "setting.bg_role == 'custom'"
    },
    {
      "type": "gradient",
      "id": "bg_role_gradient",
      "label": "Background Gradient",
      "conditional": "setting.bg_role == 'gradient'"
    }
  ],
  "blocks": [{ "type": "tabs" }, { "type": "@theme" }],
  "presets": [
    {
      "name": "Tabs",
      "settings": {},
      "blocks": {
        "tabs": { "type": "tabs" }
      },
      "block_order": ["tabs"]
    }
  ]
}
{% endschema %}
