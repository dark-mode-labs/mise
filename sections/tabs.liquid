{% assign s = section.settings %}

{% assign bg_color_value = blank %}
{% if s.bg_role == 'palette' and s.bg_role_palette != blank %}
  {% assign bg_color_value = 'var(--palette-{{ s.bg_role_palette }})' %}
{% elsif s.bg_role == 'gradient' and s.bg_role_gradient != blank %}
  {% assign bg_color_value = 'var(--gradient-{{ s.bg_role_gradient }})' %}
{% elsif s.bg_role == 'custom' and s.bg_role_custom != blank %}
  {% assign bg_color_value = s.bg_role_custom %}
{% endif %}

{% assign surface_safe = s.surface_id | default: 'default' %}
{% assign bg_role_safe = s.bg_role | default: 'none' %}
{% assign bg_class = '' %}
{% if bg_color_value == blank and bg_role_safe != 'none' %}
  {% assign bg_class = 'bg-' | append: bg_role_safe %}
{% endif %}

{% assign margin_styles = blank %}

{% assign bg_layer_styles = blank %}
{% if bg_color_value != blank %}
  {% assign bg_layer_styles = bg_layer_styles | push: 'background: {{ bg_color_value }}' %}
{% endif %}

<section
  class='tabs-section surface-{{ surface_safe }} relative isolate mt-{{ s.margin_top }} mb-{{ s.margin_bottom }} ml-{{ s.margin_left }} mr-{{ s.margin_right }}'
  style='{{ margin_styles | join: ';' }}'
  {{ context.attached_attributes }}
>
  <div
    class='tabs-bg-layer relative limit-width width-{{ s.width_bg }} {{ bg_class }} pt-{{ s.padding_top }} pb-{{ s.padding_bottom }} pl-{{ s.padding_left }} pr-{{ s.padding_right }}'
    style='{{ bg_layer_styles | join: ';' }}'
  >
    {% content_for 'blocks' %}
  </div>
</section>
{% schema %}
{
  "name": "Tabs",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "width",
      "id": "width_bg",
      "label": "Background Width",
      "default": "fill"
    },
    {
      "type": "space",
      "id": "padding_top",
      "label": "Padding Top",
      "default": "sm"
    },
    {
      "type": "space",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": "sm"
    },
    {
      "type": "space",
      "id": "padding_left",
      "label": "Padding Left",
      "default": "sm"
    },
    {
      "type": "space",
      "id": "padding_right",
      "label": "Padding Right",
      "default": "sm"
    },
    {
      "type": "space",
      "id": "margin_top",
      "label": "Margin Top",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_left",
      "label": "Margin Left",
      "default": "none"
    },
    {
      "type": "space",
      "id": "margin_right",
      "label": "Margin Right",
      "default": "none"
    },
    {
      "type": "header",
      "content": "Theme"
    },
    {
      "type": "surface",
      "id": "surface_id",
      "label": "Color Scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "bg_role",
      "label": "Background",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "body-alt",
          "label": "Body (alt)"
        },
        {
          "value": "surface",
          "label": "Surface"
        },
        {
          "value": "surface-alt",
          "label": "Surface (alt)"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "button",
          "label": "Button"
        },
        {
          "value": "control",
          "label": "Control"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "palette",
      "id": "bg_role_palette",
      "label": "Background Palette Token",
      "default": "brand",
      "conditional": "setting.bg_role == 'palette'"
    },
    {
      "type": "color",
      "id": "bg_role_custom",
      "label": "Raw Background",
      "conditional": "setting.bg_role == 'custom'"
    },
    {
      "type": "gradient",
      "id": "bg_role_gradient",
      "label": "Background Gradient",
      "conditional": "setting.bg_role == 'gradient'"
    }
  ],
  "blocks": [
    {
      "type": "tab-group"
    },
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name": "Tabs",
      "settings": {},
      "blocks": {
        "tab-group": {
          "type": "tab-group"
        }
      },
      "block_order": ["tab-group"]
    }
  ]
}
{% endschema %}
