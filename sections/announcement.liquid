{% assign s = section.settings %}

{% assign bg_color_value = blank %}
{% if s.bg_role == 'palette' and s.bg_role_palette != blank %}
  {% assign bg_color_value = 'var(--palette-{{ s.bg_role_palette }})' %}
{% elsif s.bg_role == 'gradient' and s.bg_role_gradient != blank %}
  {% assign bg_color_value = 'var(--gradient-{{ s.bg_role_gradient }})' %}
{% elsif s.bg_role == 'custom' and s.bg_role_custom != blank %}
  {% assign bg_color_value = s.bg_role_custom %}
{% endif %}

{% assign bg_class = 'bg-{{ s.bg_role }}' %}
{% if bg_color_value != blank %}{% assign bg_class = '' %}{% endif %}

{% assign bg_layer_style = blank %}
{% if bg_color_value != blank %}
  {% assign bg_layer_style = bg_layer_style | push: 'background: {{ bg_color_value }}' %}
{% endif %}
{% assign bg_layer_style_str = bg_layer_style | join: ';' %}

{% assign styles = blank %}
{% if s.margin_vertical == 'custom' %}
  {% assign styles = styles
    | push: '--space-mt: {{ s.margin_vertical_custom_top }}rem'
    | push: '--space-mb: {{ s.margin_vertical_custom_bottom }}rem'
  %}
{% endif %}
{% if s.margin_horizontal == 'custom' %}
  {% assign styles = styles
    | push: '--space-ml: {{ s.margin_horizontal_custom_left }}rem'
    | push: '--space-mr: {{ s.margin_horizontal_custom_right }}rem'
  %}
{% endif %}
{% assign style_str = styles | join: ';' %}

<section
  class='section-announcement surface-{{ s.surface_id }} z-header-top ts-caption group select-none margin-my-{{ s.margin_vertical }} margin-mx-{{ s.margin_horizontal }}'
  style='{{ style_str }}'
  data-behavior='slideshow'
  data-autoplay='{{ s.autoplay }}'
  data-speed='{{ s.autoplay_speed }}'
  data-infinite='true'
  {{ context.attached_attributes }}
>
  <div
    class='width-{{ s.width_bg }} limit-width {{ bg_class }} border-b border-default'
    style='{{ bg_layer_style_str }}'
  >
    <div class='width-{{ s.width }} limit-width'>
      <div class='slideshow-track flex w-full overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-hide cursor-grab active:cursor-grabbing'>
        {% content_for 'blocks' %}
      </div>

      {% if s.show_arrows %}
        <div
          class='slideshow-nav absolute inset-0 pointer-events-none flex items-center justify-between px-4 opacity-0 group-hover:opacity-100 transition-opacity'
          style='display: none'
        >
          <button type='button' class='slideshow-prev pointer-events-auto p-1 btn-nav' aria-label='Previous'>
            {% render 'icon', name: 'chevron-left', class: 'w-3 h-3' %}
          </button>
          <button type='button' class='slideshow-next pointer-events-auto p-1 btn-nav' aria-label='Next'>
            {% render 'icon', name: 'chevron-right', class: 'w-3 h-3' %}
          </button>
        </div>
      {% endif %}

      {% if s.show_close %}
        <button
          type='button'
          class='absolute right-2 top-1/2 -translate-y-1/2 p-2 hover:opacity-60 z-floating'
          onclick="this.closest('.section-announcement').remove()"
          aria-label='Dismiss'
        >
          {% render 'icon', name: 'close', class: 'w-3 h-3' %}
        </button>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Announcement Bar",
  "restriction": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "width",
      "id": "width",
      "label": "Max Content Width",
      "default": "fill"
    },
    {
      "type": "width",
      "id": "width_bg",
      "label": "Background Width",
      "default": "fill"
    },
    {
      "type": "space",
      "id": "margin_vertical",
      "label": "Vertical Margin",
      "default": "none"
    },
    {
      "type": "range",
      "id": "margin_vertical_custom_top",
      "label": "Custom Top Margin",
      "min": -8,
      "max": 8,
      "step": 0.25,
      "default": 0,
      "unit": "rem",
      "conditional": "setting.margin_vertical == 'custom'"
    },
    {
      "type": "range",
      "id": "margin_vertical_custom_bottom",
      "label": "Custom Bottom Margin",
      "min": -8,
      "max": 8,
      "step": 0.25,
      "default": 0,
      "unit": "rem",
      "conditional": "setting.margin_vertical == 'custom'"
    },
    {
      "type": "space",
      "id": "margin_horizontal",
      "label": "Horizontal Margin",
      "default": "none"
    },
    {
      "type": "range",
      "id": "margin_horizontal_custom_left",
      "label": "Custom Left Margin",
      "min": -8,
      "max": 8,
      "step": 0.25,
      "default": 0,
      "unit": "rem",
      "conditional": "setting.margin_horizontal == 'custom'"
    },
    {
      "type": "range",
      "id": "margin_horizontal_custom_right",
      "label": "Custom Right Margin",
      "min": -8,
      "max": 8,
      "step": 0.25,
      "default": 0,
      "unit": "rem",
      "conditional": "setting.margin_horizontal == 'custom'"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Speed (s)",
      "min": 3,
      "max": 10,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Arrows on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show Close Button",
      "default": false
    },
    {
      "type": "header",
      "content": "Theme"
    },
    {
      "type": "surface",
      "id": "surface_id",
      "label": "Color Scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "bg_role",
      "label": "Background",
      "default": "body",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "body-alt",
          "label": "Body (alt)"
        },
        {
          "value": "surface",
          "label": "Surface"
        },
        {
          "value": "surface-alt",
          "label": "Surface (alt)"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "button",
          "label": "Button"
        },
        {
          "value": "control",
          "label": "Control"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "palette",
      "id": "bg_role_palette",
      "label": "Background Palette Token",
      "default": "brand",
      "conditional": "setting.bg_role == 'palette'"
    },
    {
      "type": "color",
      "id": "bg_role_custom",
      "label": "Raw Background",
      "conditional": "setting.bg_role == 'custom'"
    },
    {
      "type": "gradient",
      "id": "bg_role_gradient",
      "label": "Background Gradient",
      "conditional": "setting.bg_role == 'gradient'"
    }
  ],
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": {
        "msg1": {
          "type": "_announcement",
          "settings": {
            "text": "Reserve Now"
          }
        },
        "msg2": {
          "type": "_announcement",
          "settings": {
            "text": "Live Music Friday"
          }
        }
      },
      "block_order": ["msg1", "msg2"]
    }
  ]
}
{% endschema %}
