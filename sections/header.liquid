{% assign s = section.settings %}

{%- capture bg_color_value -%}
  {%- render 'role-color-value', kind: 'bg', role: s.bg_role,
      palette: s.bg_role_palette, custom: s.bg_role_custom, gradient: s.bg_role_gradient -%}
{%- endcapture -%}

{%- capture text_override_value -%}
  {%- if s.text_role != 'primary' -%}
    {%- render 'role-color-value', kind: 'text', role: s.text_role,
      palette: s.text_role_palette, custom: s.text_role_custom, slots: true -%}
  {%- endif -%}
{%- endcapture -%}

{% assign is_overlay = false %}
{% if s.header_overlay_mode == 'overlay' or s.header_overlay_mode == 'transparent' %}
  {% assign is_overlay = true %}
{% endif %}

{% assign needs_spacer = false %}
{% assign positions = blank %}

{% if s.sticky_behavior == 'always' or s.sticky_behavior == 'on_scroll_up' %}
  {% if s.sticky_behavior == 'always' and is_overlay != true %}
    {% assign positions = positions | push: 'sticky top-[var(--top-nav,0)] inset-x-0' %}
  {% else %}
    {% assign positions = positions | push: 'fixed top-[var(--top-nav,0)] inset-x-0' %}
    {% unless is_overlay %}
      {% assign needs_spacer = true %}
    {% endunless %}
  {% endif %}
{% elsif is_overlay %}
  {% assign positions = positions | push: 'absolute top-[var(--top-nav,0)] inset-x-0' %}
{% else %}
  {% assign positions = positions | push: 'relative' %}
{% endif %}

{% assign position_class_str = positions | join: ' ' %}

{% assign bg_class = 'bg-{{ s.bg_role }}' %}
{% if bg_color_value != blank %}{% assign bg_class = '' %}{% endif %}

{% assign header_classes = 'header-section z-header transition-all duration-300'
  | push: position_class_str
  | push: 'surface-{{ s.surface_id }}'
  | push: 'bp-{{ s.mobile_breakpoint }}'
  | push: 'mobile-{{ s.mobile_layout }}'
  | push: 'mt-{{ s.margin_top }} mb-{{ s.margin_bottom }}'
  | push: 'ml-{{ s.margin_left }} mr-{{ s.margin_right }}'
%}
{% if s.mobile_actions == 'bar' %}
  {% assign header_classes = header_classes | push: 'actions-in-bar' %}
{% endif %}

{% assign bar_pb = 'pb-{{ s.padding_bottom }}' %}
{% assign grid_pb = '' %}
{% if s.mobile_nav_mode == 'panel' %}
  {% assign bar_pb = '' %}
  {% assign grid_pb = 'pb-{{ s.padding_bottom }}' %}
{% endif %}
{% assign bg_layer_classes = 'header-bar limit-width'
  | push: 'width-{{ s.width_bg }}'
  | push: bg_class
  | push: 'pt-{{ s.padding_top }}'
  | push: bar_pb
  | push: 'pl-{{ s.padding_left }} pr-{{ s.padding_right }}'
%}

{%- capture border_color_value -%}
  {%- render 'role-color-value', kind: 'border', role: s.border_role,
      palette: s.border_role_palette, custom: s.border_role_custom -%}
{%- endcapture -%}

{% unless s.border_mode == 'none' or s.border_mode == blank %}
  {% assign bg_layer_classes = bg_layer_classes
    | push: 'group-border-{{ s.border_mode }}'
    | push: 'group-border-size-{{ s.border_size }}'
  %}
  {% if s.border_role and s.border_role != 'none' and s.border_role != 'custom' and s.border_role != 'palette' %}
    {% assign bg_layer_classes = bg_layer_classes | push: 'border-{{ s.border_role }}' %}
  {% endif %}
  {% if s.border_mode == 'custom' %}
    {% assign bg_layer_classes = bg_layer_classes
      | push_if: 'group-border-custom-left', s.border_custom_left
      | push_if: 'group-border-custom-right', s.border_custom_right
      | push_if: 'group-border-custom-top', s.border_custom_top
      | push_if: 'group-border-custom-bottom', s.border_custom_bottom
    %}
  {% endif %}
{% endunless %}
{% if s.backdrop_blur == 'base' %}
  {% assign bg_layer_classes = bg_layer_classes | push: 'backdrop-blur' %}
{% elsif s.backdrop_blur and s.backdrop_blur != 'none' %}
  {% assign bg_layer_classes = bg_layer_classes | push: 'backdrop-blur-{{ s.backdrop_blur }}' %}
{% endif %}

{% assign header_class_str = header_classes | join: ' ' %}
{% assign bg_layer_class_str = bg_layer_classes | join: ' ' %}

{% assign styles = blank %}
{% if text_override_value != blank %}
  {% assign styles = styles | push: '--text: {{ text_override_value }}' %}
{% endif %}
{% assign style_str = styles | join: ';' %}

{% assign bar_styles = blank %}
{% if bg_color_value != blank %}
  {% assign bar_styles = bar_styles | push: 'background: {{ bg_color_value }}' %}
{% endif %}
{% unless s.border_mode == 'none' or s.border_mode == blank %}
  {% assign bar_styles = bar_styles | push: '--border-style: {{ s.border_style }}' %}
  {% if s.border_size == 'custom' %}
    {% assign bar_styles = bar_styles | push: '--border-width: {{ s.border_size_custom }}px' %}
  {% endif %}
  {% if border_color_value != blank -%}
    {%- assign bar_styles = bar_styles | push: '--border: {{ border_color_value }}' -%}
  {%- endif %}
{% endunless %}
{% assign bar_style_str = bar_styles | join: ';' %}

{% capture slot_logo %}{% content_for 'block', type: 'group', id: 'header-logo' %}{% endcapture %}
{% capture slot_actions %}{% content_for 'block', type: '_header-actions', id: 'header-actions' %}{% endcapture %}
{% capture slot_nav %}{% content_for 'block', type: '_header-menu', id: 'header-menu' %}{% endcapture %}
{% capture slot_drawer_nav %}{% content_for 'block', type: '_header-menu', id: 'header-drawer-menu' %}{% endcapture %}
{% capture slot_drawer_close %}{% content_for 'block', type: 'button', id: 'header-drawer-close' %}{% endcapture %}
{% capture slot_drawer_note %}{% content_for 'block', type: 'text', id: 'header-drawer-note' %}{% endcapture %}

{%- capture toggle_text_color -%}
  {%- if s.toggle_text_role != 'primary' -%}
    {%- render 'role-color-value', kind: 'text', role: s.toggle_text_role,
      palette: s.toggle_text_role_palette, custom: s.toggle_text_role_custom, slots: true -%}
  {%- endif -%}
{%- endcapture -%}
{%- capture toggle_border_value -%}
  {%- render 'role-color-value', kind: 'border', role: s.toggle_border_role,
      palette: s.toggle_border_role_palette, custom: s.toggle_border_role_custom -%}
{%- endcapture -%}
{% assign toggle_classes = 'header-mobile-toggle hover:opacity-70 inline-flex items-center justify-center shrink-0' %}
{% if s.toggle_shape == 'circle' %}
  {% assign toggle_classes = '{{ toggle_classes }} rounded-full' %}
{% endif %}
{% if s.toggle_border_role != blank and s.toggle_border_role != 'none' %}
  {% assign toggle_classes = '{{ toggle_classes }} group-border-full group-border-size-{{ s.toggle_border_size }}' %}
  {% if s.toggle_border_role != 'custom' and s.toggle_border_role != 'palette' %}
    {% assign toggle_classes = '{{ toggle_classes }} border-{{ s.toggle_border_role }}' %}
  {% endif %}
{% endif %}
{% assign toggle_styles = blank %}
{% if s.toggle_size > 0 %}
  {% assign toggle_styles = toggle_styles
    | push: 'width: {{ s.toggle_size }}rem'
    | push: 'height: {{ s.toggle_size }}rem'
  %}
{% else %}
  {% assign toggle_classes = '{{ toggle_classes }} p-2' %}
{% endif %}
{% if toggle_border_value != blank %}
  {% assign toggle_styles = toggle_styles | push: '--border: {{ toggle_border_value }}' %}
{% endif %}
{% if toggle_text_color != blank %}
  {% assign toggle_styles = toggle_styles | push: 'color: {{ toggle_text_color }}' %}
{% endif %}
{% assign toggle_style_str = toggle_styles | join: ';' %}

{% capture hamburger_btn %}
  {% if s.show_mobile_menu %}
    <button
      type='button'
      class='{{ toggle_classes }}'
      style='{{ toggle_style_str }}'
      data-action='toggle-drawer'
      aria-label='Menu'
    >
      {% render 'icon', name: 'menu', class: 'w-6 h-6' %}
    </button>
  {% endif %}
{% endcapture %}

<header
  class='{{ header_class_str }}'
  data-behavior='header'
  data-sticky='{{ s.sticky_behavior }}'
  data-transparent='{% if s.header_overlay_mode == 'transparent' %}true{% else %}false{% endif %}'
  style='{{ style_str }}'
  {{ context.attached_attributes }}
>
  <div class='{{ bg_layer_class_str }}' style='{{ bar_style_str }}'>
    {% assign grid_track = '' %}
    {% if s.nav_track == 'balanced' %}{% assign grid_track = 'nav-track-balanced' %}{% endif %}
    <div class='width-{{ s.width }} header-grid limit-width {{ grid_pb }} {{ grid_track }}'>
      <div class='flex items-center justify-start gap-4'>
        {% if s.mobile_layout != 'logo_left' %}{{ hamburger_btn }}{% endif %}

        {% if s.desktop_layout == 'logo_left' %}
          <div class='flex-shrink-0 hidden header-logo-desktop'>{{ slot_logo }}</div>
          {% if s.show_nav and s.nav_alignment == 'left' %}{{ slot_nav }}{% endif %}
        {% else %}
          {% if s.show_nav %}{{ slot_nav }}{% endif %}
        {% endif %}

        {% if s.mobile_layout == 'logo_left' %}
          <div class='header-logo-mobile'>{{ slot_logo }}</div>
        {% endif %}
      </div>

      <div class='flex items-center justify-center'>
        {% if s.show_nav and s.desktop_layout == 'logo_left' and s.nav_alignment == 'center' %}{{ slot_nav }}{% endif %}

        {% if s.desktop_layout != 'logo_left' or s.mobile_layout == 'logo_center' %}
          {% assign logo_wrap_class = '' %}
          {% if s.desktop_layout == 'logo_left' and s.mobile_layout == 'logo_center' %}
            {% assign logo_wrap_class = 'header-logo-mobile' %}
          {% endif %}
          <div class='{{ logo_wrap_class }}'>{{ slot_logo }}</div>
        {% endif %}
      </div>

      <div class='flex items-center justify-end gap-{{ s.actions_gap }}'>
        {% if s.show_nav and s.desktop_layout == 'logo_left' and s.nav_alignment == 'right' %}{{ slot_nav }}{% endif %}

        {% if s.mobile_layout == 'logo_right' %}
          <div class='header-logo-mobile'>{{ slot_logo }}</div>
        {% endif %}

        {% if s.show_actions %}{{ slot_actions }}{% endif %}

        {% if s.show_search %}
          <a href='/search' class='p-2 hover:opacity-70'>
            <span class='sr-only'>Search</span>
            {% render 'icon', name: 'search', class: 'w-5 h-5' %}
          </a>
        {% endif %}

        {% if s.show_cart %}
          {%- capture cart_bg_color -%}
            {%- render 'role-color-value', kind: 'bg', role: s.cart_bg_role,
                palette: s.cart_bg_role_palette, custom: s.cart_bg_role_custom -%}
          {%- endcapture -%}
          {%- capture cart_text_color -%}
            {%- if s.cart_text_role != 'primary' -%}
              {%- render 'role-color-value', kind: 'text', role: s.cart_text_role,
                palette: s.cart_text_role_palette, custom: s.cart_text_role_custom, slots: true -%}
            {%- endif -%}
          {%- endcapture -%}
          {%- capture cart_border_color -%}
            {%- render 'role-color-value', kind: 'border', role: s.cart_border_role,
                palette: s.cart_border_role_palette, custom: s.cart_border_role_custom -%}
          {%- endcapture -%}
          {%- capture badge_bg_color -%}
            {%- render 'role-color-value', kind: 'bg', role: s.cart_badge_bg_role,
                palette: s.cart_badge_bg_role_palette, custom: s.cart_badge_bg_role_custom -%}
          {%- endcapture -%}
          {%- capture badge_text_color -%}
            {%- if s.cart_badge_text_role != 'primary' -%}
              {%- render 'role-color-value', kind: 'text', role: s.cart_badge_text_role,
                palette: s.cart_badge_text_role_palette, custom: s.cart_badge_text_role_custom, slots: true -%}
            {%- endif -%}
          {%- endcapture -%}
          {% assign cart_button_styles = blank %}
          {% if s.cart_size > 0 %}
            {% assign cart_button_styles = cart_button_styles
              | push: 'width: {{ s.cart_size }}rem'
              | push: 'height: {{ s.cart_size }}rem'
            %}
          {% endif %}
          {% if cart_bg_color != blank %}
            {% assign cart_button_styles = cart_button_styles | push: 'background: {{ cart_bg_color }}' %}
          {% endif %}
          {% if cart_text_color != blank %}
            {% assign cart_button_styles = cart_button_styles | push: 'color: {{ cart_text_color }}' %}
          {% endif %}
          {% if s.cart_shadow_color_override and s.cart_shadow_color != blank %}
            {% assign cart_button_styles = cart_button_styles | push: '--shadow: {{ s.cart_shadow_color }}' %}
          {% endif %}
          {% if cart_border_color != blank %}
            {% assign cart_button_styles = cart_button_styles
              | push: '--border: {{ cart_border_color }}'
              | push: '--border-style: solid'
            %}
          {% endif %}
          {% assign cart_btn_class = 'header-cart-btn relative hover:opacity-90 inline-flex items-center justify-center shrink-0' %}
          {% if s.cart_shadow %}
            {% assign cart_btn_class = cart_btn_class | append: ' shadow-lg' %}
          {% endif %}
          {% if cart_border_color != blank %}
            {% assign cart_btn_class = cart_btn_class
              | append: ' group-border-full group-border-size-{{ s.cart_border_size }}'
            %}
          {% elsif s.cart_border_role != blank
            and s.cart_border_role != 'none'
            and s.cart_border_role != 'custom'
            and s.cart_border_role != 'palette'
          %}
            {% assign cart_btn_class = cart_btn_class
              | append: ' group-border-full group-border-size-{{ s.cart_border_size }}'
              | append: ' border-{{ s.cart_border_role }}'
            %}
          {% endif %}
          {% assign cart_has_padding = false %}
          {% unless s.cart_padding_top == blank or s.cart_padding_top == 'none' -%}
            {%- assign cart_has_padding = true -%}
          {%- endunless %}
          {% unless s.cart_padding_bottom == blank or s.cart_padding_bottom == 'none' -%}
            {%- assign cart_has_padding = true -%}
          {%- endunless %}
          {% unless s.cart_padding_left == blank or s.cart_padding_left == 'none' -%}
            {%- assign cart_has_padding = true -%}
          {%- endunless %}
          {% unless s.cart_padding_right == blank or s.cart_padding_right == 'none' -%}
            {%- assign cart_has_padding = true -%}
          {%- endunless %}
          {% if s.cart_shape == 'circle' or cart_bg_color != blank or cart_border_color != blank %}
            {% assign cart_btn_class = cart_btn_class | append: ' rounded-full' %}
          {% elsif cart_has_padding %}
            {% assign cart_btn_class = cart_btn_class | append: ' hover:opacity-70' %}
          {% else %}
            {% assign cart_btn_class = cart_btn_class | append: ' p-2 hover:opacity-70' %}
          {% endif %}
          {% if cart_has_padding %}
            {% assign cart_btn_class = cart_btn_class
              | append: ' pt-{{ s.cart_padding_top }} pb-{{ s.cart_padding_bottom }}'
              | append: ' pl-{{ s.cart_padding_left }} pr-{{ s.cart_padding_right }}'
            %}
          {% endif %}
          <a
            data-action='open-cart'
            class='{{ cart_btn_class }}'
            style='{{ cart_button_styles | join: ";" }}'
          >
            <span class='sr-only' data-cart-aria aria-live='polite'>{{ 'cart.aria_label_empty' | t }}</span>
            {% if s.cart_icon_svg != blank %}
              {{ s.cart_icon_svg }}
            {% else %}
              {% render 'icon', name: 'bag', class: 'w-6 h-6' %}
            {% endif %}
            {% assign badge_styles = blank %}
            {% if badge_bg_color != blank %}
              {% assign badge_styles = badge_styles | push: 'background: {{ badge_bg_color }}' %}
            {% endif %}
            {% if badge_text_color != blank %}
              {% assign badge_styles = badge_styles | push: 'color: {{ badge_text_color }}' %}
            {% endif %}
            <span
              class='cart-count-badge'
              data-cart-badge
              data-empty
              style='{{ badge_styles | join: ";" }}'
              data-aria-empty='{{ 'cart.aria_label_empty' | t }}'
              data-aria-one='{{ 'cart.aria_label_one' | t }}'
              data-aria-other='{{ 'cart.aria_label_other' | t }}'
              ><span data-cart-count>
                {%- if request.cart_count > 99 -%}
                  99+
                {%- elsif request.cart_count > 0 -%}
                  {{- request.cart_count -}}
                {%- endif -%}
              </span></span
            >
          </a>
        {% endif %}

        {% if s.mobile_layout == 'logo_left' %}{{ hamburger_btn }}{% endif %}
      </div>
    </div>
    {% assign actions_in_drawer = slot_actions %}
    {% if s.mobile_actions == 'bar' %}{% assign actions_in_drawer = blank %}{% endif %}
    {% if s.show_mobile_menu != false and s.show_nav != false %}
      {% assign drawer_surface = s.drawer_surface_id | default: s.surface_id %}
      {%- capture drawer_bg_value -%}
        {%- render 'role-color-value', kind: 'bg', role: s.drawer_bg_role,
            palette: s.drawer_bg_role_palette, custom: s.drawer_bg_role_custom,
            gradient: s.drawer_bg_role_gradient -%}
      {%- endcapture -%}
      {% capture drawer_html %}{% render 'header-drawer',
        nav_html: slot_drawer_nav,
        drawer_surface_id: drawer_surface,
        drawer_bg_role: s.drawer_bg_role,
        drawer_bg_value: drawer_bg_value,
        drawer_alpha_pct: s.drawer_backdrop_alpha,
        drawer_width: s.drawer_width,
        drawer_effect: s.drawer_effect,
        close_html: slot_drawer_close,
        note_html: slot_drawer_note,
        drawer_pad_top: s.drawer_padding_top,
        drawer_pad_right: s.drawer_padding_right,
        drawer_pad_bottom: s.drawer_padding_bottom,
        drawer_pad_left: s.drawer_padding_left,
        nav_mode: s.mobile_nav_mode,
        actions_html: actions_in_drawer
      %}{% endcapture %}
      {% if s.mobile_nav_mode == 'panel' %}{{ drawer_html }}{% endif %}
    {% endif %}
  </div>
  {% unless s.mobile_nav_mode == 'panel' %}{{ drawer_html }}{% endunless %}
</header>

{% if needs_spacer %}
  <div class='w-full h-16'></div>
{% endif %}
{% schema %}
{
  "name": "Header",
  "restriction": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "width",
      "id": "width",
      "label": "Max Content Width",
      "default": "fill"
    },
    {
      "type": "width",
      "id": "width_bg",
      "label": "Background Width",
      "default": "fill"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Logo placement",
      "options": [
        {
          "value": "logo_center",
          "label": "Center"
        },
        {
          "value": "logo_left",
          "label": "Left"
        }
      ],
      "default": "logo_center"
    },
    {
      "type": "select",
      "id": "nav_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "info": "Desktop only.",
      "conditional": "setting.desktop_layout == 'logo_left'"
    },
    {
      "type": "select",
      "id": "nav_track",
      "label": "Nav track",
      "options": [
        {
          "value": "shared",
          "label": "Share free space"
        },
        {
          "value": "balanced",
          "label": "Balance sides"
        }
      ],
      "default": "shared",
      "info": "Balanced puts the middle group on the page centre whatever the sides weigh. Desktop only.",
      "conditional": "setting.desktop_layout == 'logo_left'"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile logo placement",
      "options": [
        {
          "value": "logo_center",
          "label": "Center"
        },
        {
          "value": "logo_left",
          "label": "Left"
        },
        {
          "value": "logo_right",
          "label": "Right"
        }
      ],
      "default": "logo_center"
    },
    {
      "type": "select",
      "id": "mobile_actions",
      "label": "Mobile Actions",
      "info": "Where the header actions live below the nav breakpoint.",
      "default": "drawer",
      "options": [
        {
          "value": "drawer",
          "label": "In the menu"
        },
        {
          "value": "bar",
          "label": "In the bar"
        }
      ]
    },
    {
      "type": "space",
      "id": "actions_gap",
      "label": "Actions Gap",
      "default": "sm",
      "info": "Separation between the header's action controls."
    },
    {
      "type": "select",
      "id": "toggle_shape",
      "label": "Menu Button Shape",
      "default": "icon",
      "options": [
        {
          "value": "icon",
          "label": "Icon only"
        },
        {
          "value": "circle",
          "label": "Circle"
        }
      ]
    },
    {
      "type": "range",
      "id": "toggle_size",
      "label": "Menu Button Size",
      "min": 0,
      "max": 5,
      "step": 0.125,
      "unit": "rem",
      "default": 0,
      "info": "0 = default icon-only sizing."
    },
    {
      "type": "select",
      "subtype": "border_role",
      "id": "toggle_border_role",
      "label": "Menu Button Border",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "emphasis",
          "label": "Emphasis"
        },
        {
          "value": "palette",
          "label": "Base Palette"
        },
        {
          "value": "custom",
          "label": "Raw Color"
        }
      ]
    },
    {
      "type": "palette",
      "id": "toggle_border_role_palette",
      "label": "Menu Button Border Token",
      "conditional": "setting.toggle_border_role == 'palette'"
    },
    {
      "type": "color",
      "id": "toggle_border_role_custom",
      "label": "Menu Button Border Color",
      "conditional": "setting.toggle_border_role == 'custom'"
    },
    {
      "type": "select",
      "subtype": "border_size",
      "id": "toggle_border_size",
      "label": "Menu Button Border Width",
      "default": "xxs",
      "options": [
        {
          "value": "xxs",
          "label": "XXS",
          "info": "1px"
        },
        {
          "value": "xs",
          "label": "XS",
          "info": "2px"
        },
        {
          "value": "sm",
          "label": "SM",
          "info": "4px"
        },
        {
          "value": "md",
          "label": "MD",
          "info": "6px"
        },
        {
          "value": "lg",
          "label": "LG",
          "info": "8px"
        }
      ]
    },
    {
      "type": "select",
      "id": "toggle_text_role",
      "label": "Menu Button Icon Color",
      "default": "none",
      "options": [
        { "value": "none", "label": "Inherit" },
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "subtle", "label": "Subtle" },
        { "value": "emphasis", "label": "Emphasis" },
        { "value": "on-accent", "label": "On Accent" },
        { "value": "on-button", "label": "On Button" },
        { "value": "on-control", "label": "On Control" },
        { "value": "palette", "label": "Base Palette" },
        { "value": "custom", "label": "Raw Color" }
