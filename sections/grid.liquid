{% assign s = section.settings %}

{% assign bg_color_value = blank %}
{% if s.bg_role == 'palette' and s.bg_role_palette != blank %}
  {% assign bg_color_value = 'var(--palette-{{ s.bg_role_palette }})' %}
{% elsif s.bg_role == 'gradient' and s.bg_role_gradient != blank %}
  {% assign bg_color_value = 'var(--gradient-{{ s.bg_role_gradient }})' %}
{% elsif s.bg_role == 'custom' and s.bg_role_custom != blank %}
  {% assign bg_color_value = s.bg_role_custom %}
{% endif %}
{% assign overlay_color_value = blank %}
{% if s.overlay_role == 'palette' and s.overlay_role_palette != blank %}
  {% assign overlay_color_value = 'var(--palette-{{ s.overlay_role_palette }})' %}
{% elsif s.overlay_role == 'gradient' and s.overlay_role_gradient != blank %}
  {% assign overlay_color_value = 'var(--gradient-{{ s.overlay_role_gradient }})' %}
{% elsif s.overlay_role == 'custom' and s.overlay_role_custom != blank %}
  {% assign overlay_color_value = s.overlay_role_custom %}
{% endif %}

{% assign container_classes = 'grid-layout-overlay limit-width'
  | push: 'width-{{ s.width }}'
  | push: 'height-{{ s.height }}'
  | push_if: 'overflow-hidden', s.overflow_hidden
%}
{% assign content_overlay_classes = 'grid-content-overlay'
  | push: 'pt-{{ s.padding_top }} pb-{{ s.padding_bottom }}'
  | push: 'pl-{{ s.padding_left }} pr-{{ s.padding_right }}'
%}
{% assign content_overlay_class_str = content_overlay_classes | join: ' ' %}

{% assign spacing_styles = blank %}

{% assign container_class_str = container_classes | join: ' ' %}
{% assign spacing_style_str = spacing_styles | join: ';' %}

{% assign bg_class = 'bg-{{ s.bg_role }}' %}
{% if bg_color_value != blank %}{% assign bg_class = '' %}{% endif %}

{% assign bg_layer_style = blank %}
{% if bg_color_value != blank %}
  {% assign bg_layer_style = bg_layer_style | push: 'background: {{ bg_color_value }}' %}
{% endif %}
{% if s.bg_image != blank %}
  {% assign bg_layer_style = bg_layer_style | push: 'clip: rect(0, auto, auto, 0)' %}
{% endif %}

{%- capture border_class_str -%}{%- render 'box-border-class',
  mode: s.border_mode, role: s.border_role, size: s.border_size,
  custom_left: s.border_custom_left, custom_right: s.border_custom_right,
  custom_top: s.border_custom_top, custom_bottom: s.border_custom_bottom -%}{%- endcapture -%}
{%- capture border_style_str -%}{%- render 'box-border-style',
  mode: s.border_mode, role: s.border_role, palette_token: s.border_role_palette,
  gradient_token: s.border_role_gradient, custom_color: s.border_role_custom,
  style: s.border_style, size: s.border_size, size_custom: s.border_size_custom -%}{%- endcapture -%}
{% if border_style_str != blank %}{% assign bg_layer_style = bg_layer_style | push: border_style_str %}{% endif %}

{% assign bg_layer_style_str = bg_layer_style | join: ';' %}

{% assign styles = blank %}
{% assign style_str = styles | join: ';' %}

{% assign has_overlay = false %}
{% if s.overlay_role and s.overlay_role != 'none' %}{% assign has_overlay = true %}{% endif %}
{% if overlay_color_value != blank %}{% assign has_overlay = true %}{% endif %}

{% assign has_bg_layer = false %}
{% if s.bg_image != blank or has_overlay or bg_color_value != blank %}{% assign has_bg_layer = true %}{% endif %}
{% if bg_class != '' and bg_role_safe != 'none' %}{% assign has_bg_layer = true %}{% endif %}
{% unless s.border_mode == 'none' %}{% assign has_bg_layer = true %}{% endunless %}

{% assign flex_classes = 'flex flex-wrap' %}
{% for ef_id in s.effect %}
  {% assign flex_classes = flex_classes | push: 'ef-{{ ef_id }}' %}
{% endfor %}
{% if s.content_align != blank %}
  {% assign flex_classes = flex_classes | push: 'justify-content-{{ s.content_align }}' %}
{% endif %}

{% assign flex_styles = blank %}
{% if s.card_padding == 'custom' %}
  {% assign flex_styles = flex_styles | push: 'row-gap: {{ s.card_padding_custom }}rem' %}
{% else %}
  {% assign flex_styles = flex_styles | push: 'row-gap: var(--space-{{ s.card_padding }})' %}
{% endif %}

{% assign flex_class_str = flex_classes | join: ' ' %}
{% assign flex_style_str = flex_styles | join: ';' %}

<section
  class='section-flex surface-{{ s.surface_id }} mt-{{ s.margin_top }} mb-{{ s.margin_bottom }} ml-{{ s.margin_left }} mr-{{ s.margin_right }}'
  style='{{ style_str }}'
  {{ context.attached_attributes }}
>
  {% if has_bg_layer %}
    <div
      class='grid-media-overlay width-{{ s.width_bg }} limit-width overflow-hidden {{ bg_class }} {{ border_class_str }}'
      style='{{ bg_layer_style_str }}'
    >
      <div class='grid-media-inner'>
        {% if s.bg_image != blank %}
          {% render 'media',
            src: s.bg_image,
            src_mobile: s.bg_image_mobile,
            fit: 'cover',
            loading: 'lazy',
            curtain_reveal_parallax: s.enable_curtain_parallax
          %}
        {% endif %}

        {% render 'bg-overlay',
          role: s.overlay_role,
          alpha: s.overlay_alpha,
          palette_token: s.overlay_role_palette,
          custom_color: s.overlay_role_custom,
          gradient_token: s.overlay_role_gradient
        %}
      </div>
    </div>
  {% endif %}

  <div
    class='{{ container_class_str }}'
  >
    <div class='{{ content_overlay_class_str }}' style='{{ spacing_style_str }}'>
      <div
        class='{{ flex_class_str }}'
        style='{{ flex_style_str }}'
      >
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</section>
